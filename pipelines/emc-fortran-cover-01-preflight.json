{
  "schema_version": 1,
  "name": "emc-fortran-cover-01-preflight",
  "description": "Immutable envelope/source availability check only. Refuses absent Kitchen recipe. No implementation, model dispatch, acceptance, publication or production admission.",
  "parameters": {
    "source": {
      "required": true,
      "pattern": "^/[^\\n]+$"
    },
    "kitchen": {
      "required": true,
      "pattern": "^/[^\\n]+$"
    },
    "aici": {
      "required": true,
      "pattern": "^/[^\\n]+$"
    }
  },
  "required_stages": [
    "job-envelope",
    "source-pr-5",
    "source-pr-7",
    "source-pr-8",
    "source-pr-10",
    "source-pr-11",
    "source-pr-12",
    "kitchen-owned-recipe",
    "independent-aici-checker"
  ],
  "stages": [
    {
      "kind": "command",
      "name": "job-envelope",
      "argv": [
        "sha256sum",
        "-c",
        "tasks/emc-fortran-cover-01/materials.sha256"
      ],
      "cwd": "."
    },
    {
      "kind": "command",
      "name": "source-pr-5",
      "argv": [
        "git",
        "-C",
        "{{source}}",
        "cat-file",
        "-e",
        "0655e12c0e19b3dde360ed097ee88ba7b2c6d060^{commit}"
      ],
      "cwd": "."
    },
    {
      "kind": "command",
      "name": "source-pr-7",

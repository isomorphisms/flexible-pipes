{
  "schema_version": 1,
  "name": "ib-linux-first-wave-open",
  "description": "Open the authorized IB Linux first implementation wave before source changes; record assignment bytes and the observed host.",
  "required_stages": [
    "job-envelope",
    "host-identity"
  ],
  "stages": [
    {
      "kind": "command",
      "name": "job-envelope",
      "argv": [
        "sha256sum",
        "tasks/ib-desktop/first-wave.txt"
      ],
      "cwd": "."
    },
    {
      "kind": "command",
      "name": "host-identity",
      "argv": [
        "uname",
        "-srm"
      ],
      "cwd": "."
    }
  ]
}

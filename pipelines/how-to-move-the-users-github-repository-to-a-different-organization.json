    },
    "requested_repository": {
      "required": true,
      "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]*"
    },
    "resolved_repository": {
      "required": true,
      "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]*"

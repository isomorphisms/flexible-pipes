{
  "schema_version": 1,
  "name": "fulton-cnc-02-earth",
  "parameters": {
    "m2": {
      "required": true,
      "pattern": "^/[^\\n]+$"
    },
    "producer": {
      "required": true,
      "pattern": "^/[^\\n]+$"
    },
    "cases": {
      "required": true,
      "pattern": "^/[^\\n]+$"
    }
  },
  "required_stages": [
    "m2-pole-continuation"
  ],
  "stages": [
    {
      "kind": "command",
      "name": "m2-pole-continuation",
      "argv": [
        "{{m2}}",
        "--script",
        "{{producer}}",
        "{{cases}}"
      ],
      "cwd": "."
    }
  ]
}

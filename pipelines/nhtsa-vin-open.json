{
  "schema_version": 1,
  "name": "nhtsa-vin-open",
  "description": "Open SUN-NHTSA-VIN-01 job envelope and capture execution host before tool effects.",
  "required_stages": [
    "job-envelope",
    "host-identity"
  ],
  "stages": [
    {
      "kind": "command",
      "name": "job-envelope",
      "argv": [
        "sha256sum",
        "tasks/nhtsa-vin/SUN-NHTSA-VIN-01.txt"
      ],
      "cwd": "."
    },
    {
      "kind": "command",
      "name": "host-identity",
      "argv": [
        "uname",
        "-srm"
      ],
      "cwd": "."
    }
  ]
}

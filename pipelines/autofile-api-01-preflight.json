        "3bf2fa78ea44b483533de8128f9988cbd4762d54",
        "{{aici}}",
        "e5b535193c425fa9bf5f347d66030b477dbf35ab",
        "{{kitchen}}",
        "ccdd00648073b286dd58ddaab11d60fe642ca433",
        "{{ike}}",

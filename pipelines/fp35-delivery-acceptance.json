{
  "schema_version": 1,
  "name": "fp35-delivery-acceptance",
  "description": "Qualify the existing FP stage and independent AI-CI readback contract; no platform or physical-device acceptance.",
  "parameters": {
    "ithon": {
      "required": true,
      "pattern": "/.+"
    },
    "fp-root": {
      "required": true,
      "pattern": "/.+"
    },
    "aici-root": {
      "required": true,
      "pattern": "/.+"
    },
    "aici-test": {
      "required": true,
      "pattern": "/.+"
    },
    "results": {
      "required": true,
      "pattern": "/.+"
    }
  },
  "required_stages": [
    "job-envelope",
    "fp-delivery-runtime",
    "independent-delivery-acceptance"
  ],
  "stages": [
    {
      "kind": "command",
      "name": "job-envelope",
      "argv": [
        "sha256sum",
        "tasks/fp35-close/implementation.txt"
      ],
      "cwd": "."
    },
    {
      "kind": "command",
      "name": "fp-delivery-runtime",
      "argv": [
        "{{ithon}}",
        "tests/job-delivery/runtime.pi",
        "{{fp-root}}",
        "{{ithon}}"
      ],
      "cwd": "."
    },
    {
      "kind": "command",
      "name": "independent-delivery-acceptance",
      "argv": [
        "{{ithon}}",
        "{{aici-test}}",
        "{{aici-root}}",
        "{{fp-root}}",
        "{{results}}"
      ],
      "cwd": "."
    }
  ]
}

{
  "schema_version": 1,
  "name": "dirichlet-modular-independent-check",
  "parameters": {
    "dirichlet": {"required": true, "pattern": "/.+"},
    "kitchen-task": {"required": true, "pattern": "/.+"},
    "node": {"required": true, "pattern": "/.+"},
    "grease": {"required": true, "pattern": "/.+"},
    "ike": {"required": true, "pattern": "/.+"},
    "output": {"required": true, "pattern": "/.+"},
    "source-head": {"required": true, "pattern": "[0-9a-f]{40}"},
    "relative-module": {"required": true, "pattern": "[^\\t\\r\\n]+[.]mjs"},
    "module-sha256": {"required": true, "pattern": "[0-9a-f]{64}"},
    "checker": {"required": true, "pattern": "/.+[.]mjs"},
    "checker-sha256": {"required": true, "pattern": "[0-9a-f]{64}"}
  },
  "required_stages": ["assignment", "kitchen-ike-independent-check"],
  "stages": [
    {"kind": "command", "name": "assignment", "argv": ["sha256sum", "tasks/DIR-10-coefficients.txt"]},
    {"kind": "command", "name": "kitchen-ike-independent-check", "argv": ["env", "ASAN_OPTIONS=detect_leaks=0", "{{grease}}", "{{kitchen-task}}", "run", "{{dirichlet}}", "{{node}}", "{{output}}", "{{grease}}", "{{ike}}", "{{source-head}}", "{{relative-module}}", "{{module-sha256}}", "{{checker}}", "{{checker-sha256}}"]}
  ]
}

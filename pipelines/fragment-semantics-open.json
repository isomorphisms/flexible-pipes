{
  "schema_version": 1,
  "name": "fragment-semantics-open",
  "description": "Open the authorized semantic repair before implementation; capture assignment digest and build-host identity.",
  "required_stages": [
    "job-envelope",
    "host-identity"
  ],
  "stages": [
    {
      "kind": "command",
      "name": "job-envelope",
      "argv": [
        "sha256sum",
        "tasks/fragment-semantics/assignment.txt"
      ],
      "cwd": "."
    },
    {
      "kind": "command",
      "name": "host-identity",
      "argv": [
        "uname",
        "-srm"
      ],
      "cwd": "."
    }
  ]
}

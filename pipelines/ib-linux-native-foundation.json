{
  "schema_version": 1,
  "name": "ib-linux-native-foundation",
  "description": "Replay delivered native ICK material through Kitchen and Ike, qualify its literal C dialect on the consuming host, and execute the maintained 46-case IB C/FFI consumer with failure and recovery controls.",
  "parameters": {
    "grease": {
      "required": true,
      "pattern": "/[^\\t\\r\\n]+"
    },
    "grease-engine": {
      "required": true,
      "pattern": "/[^\\t\\r\\n]+"
    },
    "ike": {
      "required": true,
      "pattern": "/[^\\t\\r\\n]+"
    },
    "compiler-program": {
      "required": true,
      "pattern": "/[^\\t\\r\\n]+"
    },
    "kitchen-task": {
      "required": true,
      "pattern": "/[^\\t\\r\\n]+"
    },
    "oracle": {
      "required": true,
      "pattern": "/[^\\t\\r\\n]+"
    },
    "ib": {
      "required": true,
      "pattern": "/[^\\t\\r\\n]+"
    },
    "aici": {
      "required": true,
      "pattern": "/[^\\t\\r\\n]+"
    },
    "bundle": {
      "required": true,
      "pattern": "/[^\\t\\r\\n]+"
    },
    "output": {
      "required": true,
      "pattern": "/[^\\t\\r\\n]+"
    },
    "ike-receipt": {
      "required": true,
      "pattern": "/[^\\t\\r\\n]+"
    },
    "kitchen-root": {
      "required": true,
      "pattern": "/[^\\t\\r\\n]+"
    },
    "material": {
      "required": true,
      "pattern": "/[^\\t\\r\\n]+"
    },
    "probe": {
      "required": true,
      "pattern": "/[^\\t\\r\\n]+"
    },
    "ick-source": {
      "required": true,
      "pattern": "[0-9a-f]{40}"
    },
    "ick-archive-sha256": {
      "required": true,
      "pattern": "[0-9a-f]{64}"
    },
    "compiler-receipt-sha256": {
      "required": true,
      "pattern": "[0-9a-f]{64}"
    },
    "runtime-receipt-sha256": {
      "required": true,
      "pattern": "[0-9a-f]{64}"
    }
  },
  "required_stages": [
    "job-envelope",
    "runtime-and-recipe-identities",
    "kitchen-ike-acceptance",
    "ike-receipt"
  ],
  "stages": [
    {
      "kind": "command",
      "name": "job-envelope",
      "argv": [
        "sha256sum",
        "tasks/ib-desktop/first-wave.txt"
      ],
      "cwd": "."
    },
    {
      "kind": "command",
      "name": "runtime-and-recipe-identities",
      "argv": [
        "sha256sum",
        "{{grease-engine}}",
        "{{ike}}",
        "{{compiler-program}}",
        "{{kitchen-task}}",
        "{{oracle}}",
        "{{probe}}"
      ],
      "cwd": "."
    },
    {
      "kind": "command",
      "name": "kitchen-ike-acceptance",
      "argv": [
        "env",
        "GREASE={{grease}}",
        "IKE={{ike}}",
        "KITCHEN_ROOT={{kitchen-root}}",
        "{{grease}}",
        "{{kitchen-task}}",
        "run",
        "{{ib}}",
        "{{aici}}",
        "{{bundle}}",
        "{{output}}",
        "{{material}}",
        "{{ick-source}}",
        "{{ick-archive-sha256}}",
        "{{probe}}",
        "{{compiler-receipt-sha256}}",
        "{{runtime-receipt-sha256}}"
      ],
      "cwd": "."
    },
    {
      "kind": "command",
      "name": "ike-receipt",
      "argv": [
        "cat",
        "{{ike-receipt}}"
      ],
      "cwd": "."
    }
  ]
}

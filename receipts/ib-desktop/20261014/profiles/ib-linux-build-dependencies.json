{
  "schema_version": 1,
  "name": "ib-linux-build-dependencies",
  "description": "Install the exact prerequisites declared by the pinned AI-CI ICK-host producer on the observed Ubuntu build container.",
  "required_stages": [
    "os-release",
    "bootstrap-package-index",
    "compiler-bootstrap-packages"
  ],
  "stages": [
    {
      "kind": "command",
      "name": "os-release",
      "argv": [
        "cat",
        "/etc/os-release"
      ],
      "cwd": "."
    },
    {
      "kind": "command",
      "name": "bootstrap-package-index",
      "argv": [
        "apt-get",
        "update"
      ],
      "cwd": "."
    },
    {
      "kind": "command",
      "name": "compiler-bootstrap-packages",
      "argv": [
        "apt-get",
        "install",
        "-y",
        "build-essential",
        "flex",
        "bison",
        "texinfo",
        "libgmp-dev",
        "libmpfr-dev",
        "libmpc-dev"
      ],
      "cwd": "."
    }
  ]
}

{
  "schema_version": 1,
  "name": "ib-linux-build-dependencies-workspace-cache",
  "description": "Feed the exact AI-CI ICK-host prerequisites using a writable task-local package cache; preserve earlier platform UID/cache failures.",
  "required_stages": [
    "compiler-bootstrap-packages"
  ],
  "stages": [
    {
      "kind": "command",
      "name": "compiler-bootstrap-packages",
      "argv": [
        "timeout",
        "120",
        "apt-get",
        "-o",
        "APT::Sandbox::User=root",
        "-o",
        "Dir::Cache::archives=/workspace/scratch/65d93ecc1fc0/apt-archives",
        "-o",
        "Acquire::http::Timeout=15",
        "-o",
        "Acquire::https::Timeout=15",
        "--no-install-recommends",
        "install",
        "-y",
        "build-essential",
        "flex",
        "bison",
        "texinfo",
        "libgmp-dev",
        "libmpfr-dev",
        "libmpc-dev"
      ],
      "cwd": "."
    }
  ]
}

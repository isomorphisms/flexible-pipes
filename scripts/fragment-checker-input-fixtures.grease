#!/usr/bin/env grease
var verifier = $1
var result = $2
if (not verifier.startsWith('/') or not result.startsWith('/')) { echo 'requires absolute checker and result paths' >&2; exit 2 }
test -x "$verifier"
test -f "$result"
var stage = "$(mktemp -d)"
"$verifier" "$result"
tac "$result" > "$stage/reordered.tsv"
cat "$result" "$result" > "$stage/duplicated.tsv"
for fixture in reordered duplicated {
  if "$verifier" "$stage/$fixture.tsv" > "$stage/$fixture-verdict.txt" 2>&1 {
    echo "FAIL $fixture result accepted" >&2
    exit 1
  }
  rg -q 'FAIL coordinate numerical comparison' "$stage/$fixture-verdict.txt"
}
if "$verifier" "$stage/missing.tsv" > "$stage/missing-verdict.txt" 2>&1 {
  echo 'FAIL unreadable result accepted' >&2
  exit 1
}
rg -q 'FAIL could not read coordinate result' "$stage/missing-verdict.txt"
echo 'PASS reordered, duplicated and unreadable result fixtures'
echo "fixture-root=$stage"
sha256sum "$result" "$stage/reordered.tsv" "$stage/duplicated.tsv" "$verifier" /workspace/scratch/3e1c4c6b7433/ai-ci/examples/autogenerated/coordinate-readback/build/exec/coordinate-readback_app/coordinate-readback.so

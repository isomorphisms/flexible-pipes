"""Unprivileged transport client; the separate service owns accepted execution."""
import os
import sys
import json
import urllib.request
from pathlib import Path
from builtins import dict, list, ValueError
from delivery import submit
from event_adapter import envelope
from installed_client import preflight
from builtins import Exception
argv ∈ list[str] ← sys.argv
environment ∈ dict[str, str] ← os.environ
readiness ∈ bool ← len(argv) == 4 and argv[1] == "readiness"
client_path ∈ str ← argv[2] if readiness else "/etc/flexible-pipes/client.json"
client ∈ dict[str, object] ← json.loads(Path(client_path).read_bytes())
directory ∈ str ← argv[3] if readiness else "/var/lib/flexible-pipes/export/" + environment["GITHUB_RUN_ID"] + "-" + environment["GITHUB_RUN_ATTEMPT"]
if readiness or client["state"] != "active":
    Path(directory).mkdir(mode=448, parents=True, exist_ok=False)
    blocked ∈ dict[str, object] ← {"status": "BLOCKED", "blocker": "DEPLOYMENT_INACTIVE" if client["state"] != "active" else "CLIENT_RUNTIME_NOT_ADMITTED", "artifacts": [], "acceptance_scope": "client-readiness", "excluded_claims": ["trusted-execution", "deployment"]}
    Path(directory + "/result.json").write_text(json.dumps(blocked, sort_keys=True))
    print(json.dumps(blocked))
    sys.exit(2)
# No hosted token is acquired until installed bytes, CA, selected endpoint,
# promoted authority, canonical control revision and route shape all agree.
try:
    admitted_install ∈ dict[str, object] ← preflight(client, client_path, "/opt/flexible-pipes/current", "/opt/catfood", True)
    if environment["GITHUB_SHA"] != admitted_install["control_commit"]:
        raise ValueError("CLIENT_STALE_WORKFLOW")
    event ∈ dict[str, object] ← json.loads(Path(argv[1]).read_bytes())
    preliminary ∈ dict[str, object] ← envelope(event, environment, "")
except Exception as failure:
    Path(directory).mkdir(mode=448, parents=True, exist_ok=False)
    blocked ∈ dict[str, object] ← {"status": "BLOCKED", "blocker": str(failure), "artifacts": [], "acceptance_scope": "client-pre-token", "excluded_claims": ["trusted-execution", "deployment"]}
    Path(directory + "/result.json").write_text(json.dumps(blocked, sort_keys=True))
    print(json.dumps(blocked))
    sys.exit(2)
try:
    job_request ∈ str ← environment["ACTIONS_ID_TOKEN_REQUEST_URL"]
    if not job_request.startswith("https://"):
        raise ValueError("ADMISSION_TRANSPORT")
    job_request ← job_request + "&audience=flexible-pipes-registered-v1"
    authorization ∈ str ← "Bearer " + environment["ACTIONS_ID_TOKEN_REQUEST_TOKEN"]
    query ∈ object ← urllib.request.Request(job_request, headers={"Authorization": authorization})
    with urllib.request.urlopen(query, timeout=15) as response:
        token_payload ∈ bytes ← response.read(32769)
    if len(token_payload) > 32768:
        raise ValueError("ADMISSION_SIZE")
    token_record ∈ dict[str, object] ← json.loads(token_payload)
    mapped ∈ dict[str, object] ← envelope(event, environment, str(token_record["value"]))
except Exception:
    Path(directory).mkdir(mode=448, parents=True, exist_ok=False)
    rejected ∈ dict[str, object] ← {"status": "BLOCKED", "blocker": "OIDC_ADMISSION_UNAVAILABLE", "artifacts": [], "acceptance_scope": "client-oidc", "excluded_claims": ["trusted-execution", "deployment"]}
    Path(directory + "/result.json").write_text(json.dumps(rejected, sort_keys=True))
    print(json.dumps(rejected))
    sys.exit(2)
result ∈ dict[str, object] ← submit(str(client["endpoint"]), str(client["ca_certificate"]), str(mapped["route"]), dict(mapped["envelope"]), directory, dict(client["accepted_release"]))
print(json.dumps({"status": result["status"], "export": directory}))
sys.exit(0 if result["status"] == "PASS" else 1)

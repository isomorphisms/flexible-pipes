"""Registered execution v1. Production reads only a root-owned deployment.

The explicit qualify mode is diagnostic authority; it cannot grant deployed
acceptance. No request is ever interpreted as executable configuration.
"""
import os
import sys
import json
import hashlib
import subprocess
import time
import uuid
import signal
import fcntl
import shutil
import stat
import platform
import ithon_frontend
from pathlib import Path
from typing import Iterable
from builtins import open, dict, list, isinstance, ValueError, RuntimeError, Exception, KeyboardInterrupt, ProcessLookupError

REQUIRED ∈ list[str] ← ["prepare", "generate-a", "generate-b", "determinism", "seal", "fixture-personal", "fixture-organization", "fixture-accepted-unverified", "fixture-visibility", "fixture-post-failure", "fixture-wrong-id", "fixture-collision", "fixture-authentication", "fixture-capability", "fixture-network", "publish"]
FIELDS ∈ list[str] ← ["source_owner", "repository", "destination_owner", "expected_login", "expected_repository_id", "target_context"]
MODES ∈ list[str] ← ["personal", "organization", "accepted-unverified", "visibility", "post-failure", "wrong-id", "collision", "authentication", "capability", "network"]
OPERATION_FIELDS ∈ list[str] ← ["operation", "operation_version", "registry_generation", "authority", "required_checks", "control_commit", "ithon", "grease", "worker", "watchdog", "generator", "parent_probe", "fixture_server", "fixture_bin", "api_validator", "seal_validator", "contract_sha256"]

def interrupt(number ∈ int, frame ∈ object) → None:
    raise KeyboardInterrupt("supervisor interrupted")

signal.signal(signal.SIGTERM, interrupt)

def record_process(path ∈ str, child ∈ object) → None:
    pid ∈ int ← child.pid
    process_state ∈ str ← Path("/proc/" + str(pid) + "/stat").read_text()
    fields ∈ list[str] ← process_state.split()
    atomic(path, {"pid": pid, "start_time": fields[21], "state": "RUNNING"})

def watch_process(directory ∈ str, child ∈ object, config ∈ dict[str, object], seconds ∈ int) → object:
    parent ∈ int ← os.getpid()
    parent_fields ∈ list[str] ← Path("/proc/" + str(parent) + "/stat").read_text().split()
    target_fields ∈ list[str] ← Path("/proc/" + str(child.pid) + "/stat").read_text().split()
    plan ∈ str ← directory + "/guard-plan.json"
    atomic(plan, {"parent_pid": parent, "parent_start": parent_fields[21], "target_pid": child.pid, "target_start": target_fields[21], "seconds": seconds})
    command ∈ list[str] ← list(config["ithon"])
    command.extend([str(config["watchdog"]), plan, directory + "/guard-result.json"])
    guard ∈ object ← subprocess.Popen(command, env=clean_environment(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return guard

def reap_interrupted(run ∈ str) → None:
    records ∈ list[Path] ← list(Path(run).rglob("process.json"))
    for path in records:
        record ∈ dict[str, object] ← read(str(path))
        if record["state"] == "RUNNING":
            pid ∈ int ← int(record["pid"])
            process_file ∈ str ← "/proc/" + str(pid) + "/stat"
            exists ∈ bool ← Path(process_file).exists()
            if exists:
                state ∈ str ← Path(process_file).read_text()
                fields ∈ list[str] ← state.split()
                if fields[21] == record["start_time"]:
                    os.killpg(pid, signal.SIGKILL)
            record["state"] ← "INTERRUPTED"
            atomic(str(path), record)

def digest(data ∈ bytes) → str:
    answer ∈ str ← hashlib.sha256(data).hexdigest()
    return answer

def encode(value ∈ object) → bytes:
    text ∈ str ← json.dumps(value, sort_keys=True, separators=(",", ":"))
    return text.encode()

def atomic(path ∈ str, value ∈ object) → None:
    temporary ∈ str ← path + "." + str(uuid.uuid4()) + ".tmp"
    with open(temporary, "xb") as stream:
        stream.write(encode(value))
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, path)

def read(path ∈ str) → dict[str, object]:
    value ∈ dict[str, object] ← json.loads(Path(path).read_bytes())
    if not isinstance(value, dict):
        raise ValueError("OBJECT_REQUIRED")
    return value

def unique_object(pairs ∈ list[tuple[str, object]]) → dict[str, object]:
    result ∈ dict[str, object] ← {}
    for pair in pairs:
        key ∈ str ← pair[0]
        if result.__contains__(key):
            raise ValueError("DUPLICATE_JSON_KEY")
        result[key] ← pair[1]
    return result

def clean_environment() → dict[str, str]:
    return {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_NO_REPLACE_OBJECTS": "1", "GIT_TERMINAL_PROMPT": "0", "HOME": "/nonexistent"}

def git(repo ∈ str, args ∈ list[str]) → bytes:
    command ∈ list[str] ← ["/usr/bin/git", "--no-replace-objects", "-c", "safe.directory=" + repo, "-C", repo]
    command.extend(args)
    child ∈ object ← subprocess.run(command, env=clean_environment(), capture_output=True, timeout=15)
    code ∈ int ← child.returncode
    output ∈ bytes ← child.stdout
    if code != 0:
        raise ValueError("SOURCE_UNAVAILABLE")
    return output

def checked_request(raw ∈ bytes) → dict[str, object]:
    if len(raw) > 16384:
        raise ValueError("REQUEST_SIZE")
    request ∈ dict[str, object] ← json.loads(raw, object_pairs_hook=unique_object)
    if not isinstance(request, dict) or set(request) != set(["schema_version", "request_id", "pipeline", "inputs"]):
        raise ValueError("REQUEST_FIELDS")
    if type(request["schema_version"]) != int or request["schema_version"] != 1 or request["pipeline"] != "kitchen-transfer-script":
        raise ValueError("UNKNOWN_OPERATION")
    import re
    if not isinstance(request["request_id"], str):
        raise ValueError("REQUEST_ID")
    matched ∈ object ← re.fullmatch("[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", str(request["request_id"]))
    if matched == None:
        raise ValueError("REQUEST_ID")
    if not isinstance(request["inputs"], dict):
        raise ValueError("INPUT_OBJECT")
    inputs ∈ dict[str, object] ← dict(request["inputs"])
    if set(inputs) != set(FIELDS):
        raise ValueError("INPUT_FIELDS")
    for name in ["source_owner", "repository", "destination_owner", "expected_login"]:
        value ∈ object ← inputs[name]
        if not isinstance(value, str):
            raise ValueError("INPUT_TYPE")
        matched ∈ object ← re.fullmatch("[A-Za-z0-9][A-Za-z0-9_.-]{0,99}", str(value))
        if matched == None:
            raise ValueError("INPUT_NAME")
    if type(inputs["expected_repository_id"]) != int or int(inputs["expected_repository_id"]) <= 0:
        raise ValueError("INPUT_ID")
    if inputs["target_context"] != "linux-x86_64-grease-v1":
        raise ValueError("UNQUALIFIED_CONTEXT")
    if inputs["source_owner"] == inputs["destination_owner"]:
        raise ValueError("SAME_OWNER")
    return request

def verify_deployment(config ∈ dict[str, object], diagnostic ∈ bool) → None:
    if config["schema_version"] != 1 or config["operation"] != "kitchen-transfer-script" or config["qualified"] != True:
        raise ValueError("UNQUALIFIED_ADAPTER")
    if config["required_checks"] != REQUIRED:
        raise ValueError("MANDATORY_CHILD_MISSING")
    if not diagnostic and config["authority"] != "deployed-trusted":
        raise ValueError("DEPLOYMENT_INACTIVE")
    uid ∈ int ← os.getuid()
    if uid != 0:
        raise ValueError("SECURITY_BOUNDARY_UNAVAILABLE: distinct worker UID required")
    # Namespace root can map only UID 0. Report this before generator effects.
    uid_map ∈ str ← Path("/proc/self/uid_map").read_text()
    mappings ∈ list[str] ← uid_map.split()
    if len(mappings) == 3 and mappings[2] == "1":
        raise ValueError("SECURITY_BOUNDARY_UNAVAILABLE: single-UID namespace")
    materials ∈ list[dict[str, object]] ← list(config["materials"])
    bound_paths ∈ list[str] ← []
    for material in materials:
        path ∈ str ← str(material["path"])
        bound_paths.append(path)
        actual ∈ bytes ← Path(path).read_bytes()
        if digest(actual) != material["sha256"]:
            raise ValueError("MATERIAL_CHANGED: " + path)
        if path.endswith(".pi"):
            checked ∈ object ← ithon_frontend.check_source(actual.decode(), path)
        repo ∈ str ← str(material["checkout"])
        commit ∈ str ← str(material["commit"])
        head ∈ str ← git(repo, ["rev-parse", "HEAD"]).decode().strip()
        if head != commit:
            raise ValueError("WRONG_SOURCE")
        blob ∈ bytes ← git(repo, ["show", commit + ":" + str(material["relative_path"])])
        if digest(blob) != material["sha256"]:
            raise ValueError("UNPUBLISHED_SOURCE")
        origin ∈ str ← git(repo, ["config", "--local", "--get", "remote.origin.url"]).decode().strip()
        if origin != material["origin"]:
            raise ValueError("WRONG_ORIGIN")
        # Publication ancestry is an availability check, not promotion.
        git(repo, ["merge-base", "--is-ancestor", commit, str(material["published_ref"])])
    tools ∈ list[dict[str, object]] ← list(config["tools"])
    tool_paths ∈ list[str] ← []
    for tool in tools:
        executable ∈ str ← str(tool["path"])
        tool_paths.append(executable)
        exists ∈ bool ← os.path.isfile(executable)
        if not exists:
            raise ValueError("MISSING_EXECUTABLE: " + executable)
        if digest(Path(executable).read_bytes()) != tool["sha256"]:
            raise ValueError("TOOL_CHANGED")
    for role in ["worker", "watchdog", "generator", "parent_probe", "fixture_server", "api_validator", "seal_validator"]:
        selected ∈ str ← str(config[role])
        if not bound_paths.__contains__(selected):
            raise ValueError("UNBOUND_IMPLEMENTATION: " + role)
    commands ∈ list[str] ← list(config["ithon"])
    grease_command ∈ list[str] ← list(config["grease"])
    commands.extend(grease_command[:2])
    for selected in commands:
        if not tool_paths.__contains__(selected) and not bound_paths.__contains__(selected):
            raise ValueError("UNBOUND_RUNTIME")
    contract ∈ dict[str, object] ← read(str(config["contract"]))
    if contract["required_checks"] != REQUIRED or contract["operation"] != "kitchen-transfer-script":
        raise ValueError("CONTRACT_CHANGED")
    if digest(Path(str(config["contract"])).read_bytes()) != config["contract_sha256"]:
        raise ValueError("CONTRACT_CHANGED")
    qualification ∈ dict[str, object] ← read(str(config["qualification"]))
    if qualification["status"] != "PASS" or qualification["scope"] != config["authority"] or qualification["materials_sha256"] != digest(encode(materials)):
        raise ValueError("STALE_QUALIFICATION")
    if qualification["tools_sha256"] != digest(encode(tools)) or qualification["environment_sha256"] != digest(encode(config["grease_environment"])):
        raise ValueError("STALE_RUNTIME_QUALIFICATION")
    operation_identity ∈ dict[str, object] ← {}
    for field in OPERATION_FIELDS:
        operation_identity[field] ← config[field]
    if qualification["operation_sha256"] != digest(encode(operation_identity)):
        raise ValueError("STALE_OPERATION_QUALIFICATION")
    if digest(Path(str(config["qualification"])).read_bytes()) != config["qualification_sha256"]:
        raise ValueError("QUALIFICATION_CHANGED")

def adapter(config ∈ dict[str, object], route ∈ str, envelope ∈ dict[str, object]) → bytes:
    if route == "workflow_dispatch":
        if envelope["workflow_ref"] != "refs/heads/main" or envelope["workflow_sha"] != config["control_commit"]:
            raise ValueError("UNQUALIFIED_WORKFLOW_REF")
        if envelope["repository_id"] != 1405888814:
            raise ValueError("WRONG_REPOSITORY")
        raw ∈ str ← str(envelope["request"])
        return raw.encode()
    if route != "pipeline-requests":
        raise ValueError("UNKNOWN_ROUTE")
    repo ∈ str ← str(config["request_mirror"])
    commit ∈ str ← str(envelope["request_commit"])
    # Resolve once; use only immutable objects, never a worktree or GITHUB_SHA.
    resolved ∈ str ← git(repo, ["rev-parse", "--verify", commit + "^{commit}"]).decode().strip()
    paths ∈ list[str] ← git(repo, ["diff", "--name-only", str(config["request_base"]), resolved]).decode().splitlines()
    if len(paths) != 1:
        raise ValueError("NON_REQUEST_CHANGE")
    path ∈ str ← paths[0]
    separators ∈ int ← path.count("/")
    if not path.startswith("requests/") or not path.endswith(".json") or separators != 1:
        raise ValueError("NON_REQUEST_CHANGE")
    entry ∈ str ← git(repo, ["ls-tree", resolved, "--", path]).decode()
    if not entry.startswith("100644 blob "):
        raise ValueError("NON_REQUEST_BLOB")
    return git(repo, ["show", resolved + ":" + path])

def bounded(command ∈ list[str], cwd ∈ str, environment ∈ dict[str, str], directory ∈ str, worker_uid ∈ int, config ∈ dict[str, object], peer ∈ object) → int:
    Path(directory).mkdir(mode=448)
    stdout_path ∈ str ← directory + "/stdout.bin"
    stderr_path ∈ str ← directory + "/stderr.bin"
    with open(stdout_path, "xb") as out:
        with open(stderr_path, "xb") as err:
            if worker_uid > 0:
                plan ∈ str ← directory + "/worker-plan.json"
                atomic(plan, {"argv": command, "environment": environment})
                os.chmod(directory, 493)
                ithon ∈ list[str] ← list(config["ithon"])
                bootstrap ∈ list[str] ← list(ithon)
                bootstrap.extend([str(config["worker"]), plan])
                no_groups ∈ list[int] ← []
                child ∈ object ← subprocess.Popen(bootstrap, cwd=cwd, env=clean_environment(), stdout=out, stderr=err, user=worker_uid, group=worker_uid, extra_groups=no_groups, start_new_session=True)
            else:
                child ∈ object ← subprocess.Popen(command, cwd=cwd, env=environment, stdout=out, stderr=err, start_new_session=True)
            start ∈ float ← time.monotonic()
            process_record ∈ str ← directory + "/process.json"
            record_process(process_record, child)
            guard ∈ object ← watch_process(directory, child, config, 62)
            try:
                while True:
                    if peer != None:
                        peer_code ∈ object ← peer.poll()
                        if peer_code != None:
                            raise RuntimeError("FIXTURE_SERVICE_FAILED: " + str(peer_code))
                    code ∈ object ← child.poll()
                    if code != None:
                        return int(code)
                    now ∈ float ← time.monotonic()
                    output_size ∈ int ← Path(stdout_path).stat().st_size
                    error_size ∈ int ← Path(stderr_path).stat().st_size
                    scratch_files ∈ Iterable[Path] ← Path(cwd).rglob("*")
                    scratch_size ∈ int ← 0
                    scratch_count ∈ int ← 0
                    for scratch_file in scratch_files:
                        scratch_count ← scratch_count + 1
                        if scratch_count > 8192:
                            raise RuntimeError("SCRATCH_ENTRY_BOUND_EXCEEDED")
                        info ∈ object ← scratch_file.lstat()
                        size ∈ int ← info.st_size
                        scratch_size ← scratch_size + size
                    if now - start > 60.0 or output_size > 1048576 or error_size > 1048576 or scratch_size > 67108864:
                        raise RuntimeError("EXECUTION_BOUND_EXCEEDED")
                    time.sleep(0.02)
            finally:
                running ∈ object ← child.poll()
                if running == None:
                    os.killpg(child.pid, signal.SIGKILL)
                    child.wait()
                final_code ∈ int ← child.returncode
                guard.wait(timeout=5)
                atomic(process_record, {"pid": child.pid, "state": "FINISHED", "exit_code": final_code, "argv": command, "executable_sha256": digest(Path(command[0]).read_bytes()), "stdout_sha256": digest(Path(stdout_path).read_bytes()), "stderr_sha256": digest(Path(stderr_path).read_bytes()), "stdout_bytes": Path(stdout_path).stat().st_size, "stderr_bytes": Path(stderr_path).stat().st_size})
    return 125

def fixture(config ∈ dict[str, object], inputs ∈ dict[str, object], artifact ∈ str, mode ∈ str, run ∈ str, uid ∈ int) → dict[str, object]:
    base ∈ str ← run + "/fixture-" + mode
    Path(base).mkdir(mode=493)
    io ∈ str ← base + "/io"
    Path(io).mkdir(mode=493)
    os.mkfifo(io + "/request", 438)
    os.mkfifo(io + "/response", 438)
    os.chmod(io + "/request", 438)
    os.chmod(io + "/response", 438)
    specification ∈ str ← base + "/fixture.json"
    atomic(specification, {"mode": mode, "inputs": inputs, "artifact_sha256": digest(Path(artifact).read_bytes())})
    ithon ∈ list[str] ← list(config["ithon"])
    server_command ∈ list[str] ← list(ithon)
    server_command.extend([str(config["fixture_server"]), io, specification])
    server_log ∈ object ← open(base + "/server.stderr.bin", "xb")
    server ∈ object ← subprocess.Popen(server_command, env=clean_environment(), stdout=subprocess.DEVNULL, stderr=server_log, start_new_session=True)
    record_process(base + "/process.json", server)
    guard ∈ object ← watch_process(base, server, config, 125)
    codes ∈ list[int] ← []
    try:
        executions ∈ int ← 2 if mode == "personal" or mode == "organization" or mode == "accepted-unverified" else 1
        for index in range(executions):
            work ∈ str ← base + "/unrelated directory '" + str(index)
            home ∈ str ← base + "/fresh home \"" + str(index)
            Path(work).mkdir(mode=448)
            Path(home).mkdir(mode=448)
            os.chown(work, uid, uid)
            os.chown(home, uid, uid)
            environment ∈ dict[str, str] ← dict(config["grease_environment"])
            environment["PATH"] ← str(config["fixture_bin"]) + ":/usr/bin:/bin"
            environment["HOME"] ← home
            environment["FP_FIXTURE_IO"] ← io
            grease ∈ list[str] ← list(config["grease"])
            grease.append(str(config["parent_probe"]))
            grease.extend(list(config["grease"]))
            grease.append(artifact)
            code ∈ int ← bounded(grease, work, environment, base + "/execution-" + str(index), uid, config, server)
            parent_output ∈ bytes ← Path(base + "/execution-" + str(index) + "/stdout.bin").read_bytes()
            if not parent_output.endswith(b"PARENT_SURVIVED\n"):
                raise ValueError("PARENT_SHELL_TERMINATED")
            codes.append(code)
        if len(codes) == 1:
            codes.append(-125)
        execution ∈ str ← base + "/execution.json"
        atomic(execution, {"first_exit": codes[0], "second_exit": codes[1], "second_state": "NOT_RUN" if executions == 1 else "EXECUTED"})
        validator ∈ list[str] ← list(ithon)
        decision ∈ str ← base + "/decision.json"
        validator.extend([str(config["api_validator"]), specification, io + "/observations.json", execution, artifact, decision])
        code ← bounded(validator, base, clean_environment(), base + "/validation", 0, config, None)
        if code != 0:
            raise ValueError("FIXTURE_VALIDATION_FAILED: " + mode)
        result ∈ dict[str, object] ← read(decision)
        if result["status"] != "PASS" or result["artifact_sha256"] != digest(Path(artifact).read_bytes()):
            raise ValueError("VALIDATOR_RECEIPT_MISMATCH")
        return result
    finally:
        try:
            os.killpg(server.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        server.wait()
        guard.wait(timeout=5)
        server_log.close()
        atomic(base + "/process.json", {"pid": server.pid, "state": "FINISHED"})

def execute(config ∈ dict[str, object], raw ∈ bytes, route ∈ str, retry ∈ bool, diagnostic ∈ bool) → dict[str, object]:
    request ∈ dict[str, object] ← checked_request(raw)
    verify_deployment(config, diagnostic)
    state ∈ str ← str(config["state_root"])
    Path(state).mkdir(mode=457, parents=True, exist_ok=True)
    request_id ∈ str ← str(request["request_id"])
    index_path ∈ str ← state + "/" + request_id + ".json"
    lock ∈ object ← open(state + "/" + request_id + ".lock", "ab")
    fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
    try:
        previous ∈ dict[str, object] ← {}
        exists ∈ bool ← Path(index_path).exists()
        attempt ∈ int ← 1
        if exists:
            previous ← read(index_path)
            if previous["request_sha256"] != digest(raw):
                raise ValueError("DUPLICATE_ID_DIFFERENT_BYTES")
            if not retry:
                existing_result ∈ dict[str, object] ← read(str(previous["result"]))
                if existing_result["status"] == "RUNNING":
                    prior_run ∈ str ← str(Path(str(previous["result"])).parent)
                    reap_interrupted(prior_run)
                    existing_result["status"] ← "INTERRUPTED"
                    existing_result["first_failure"] ← "SUPERVISOR_INTERRUPTED"
                    atomic(str(previous["result"]), existing_result)
                if existing_result["status"] == "PASS":
                    accepted_artifacts ∈ list[dict[str, object]] ← list(existing_result["artifacts"])
                    for accepted_artifact in accepted_artifacts:
                        accepted_path ∈ str ← str(accepted_artifact["retrieval_locator"])
                        if digest(Path(accepted_path).read_bytes()) != accepted_artifact["sha256"]:
                            raise ValueError("STALE_ACCEPTED_ARTIFACT")
                return existing_result
            existing_result ∈ dict[str, object] ← read(str(previous["result"]))
            if existing_result["status"] == "RUNNING":
                prior_run ∈ str ← str(Path(str(previous["result"])).parent)
                reap_interrupted(prior_run)
                existing_result["status"] ← "INTERRUPTED"
                existing_result["first_failure"] ← "SUPERVISOR_INTERRUPTED"
                atomic(str(previous["result"]), existing_result)
            attempt ← int(previous["attempt"]) + 1
        run_id ∈ str ← request_id + "-" + str(attempt) + "-" + str(uuid.uuid4())
        run ∈ str ← state + "/" + run_id
        Path(run).mkdir(mode=493)
        result_path ∈ str ← run + "/result.json"
        inputs ∈ dict[str, object] ← dict(request["inputs"])
        stages ∈ list[dict[str, object]] ← []
        for check in REQUIRED:
            stages.append({"check_id": check, "required": True, "state": "NOT_RUN"})
        result ∈ dict[str, object] ← {"schema_version": 2, "request_id": request_id, "request_sha256": digest(raw), "run_id": run_id, "attempt": attempt, "operation_id": "kitchen-transfer-script", "operation_version": config["operation_version"], "registry_generation": config["registry_generation"], "control": {"repository_id": 1405888814, "commit": config["control_commit"], "executable_sha256": digest(Path(__file__).read_bytes()), "deployment_identity": config["authority"]}, "qualification_sha256": config["qualification_sha256"], "contract_sha256": config["contract_sha256"], "source": config["materials"], "dependencies": config["tools"], "observed_build_host": {"system": platform.system(), "machine": platform.machine()}, "route": route, "stages": stages, "artifacts": [], "status": "RUNNING", "first_failure": None, "blockers": [], "acceptance_scope": "local-fixture-qualification" if diagnostic else "generated-script", "excluded_claims": ["live-transfer", "physical-device", "deployed-trusted-execution"] if diagnostic else ["live-transfer", "physical-device"], "promotion": {"state": "candidate" if diagnostic else "pending"}, "started_at": time.time(), "prior_attempt": previous}
        atomic(result_path, result)
        atomic(index_path, {"request_sha256": digest(raw), "attempt": attempt, "result": result_path})
        # A different UID for every attempt prevents concurrent workers from
        # reading/writing another attempt's private scratch, even if located.
        with open(state + "/worker-uid.lock", "ab") as uid_lock:
            fcntl.flock(uid_lock.fileno(), fcntl.LOCK_EX)
            uid_path ∈ str ← state + "/worker-uid.json"
            uid ∈ int ← 60000
            uid_exists ∈ bool ← Path(uid_path).exists()
            if uid_exists:
                uid_record ∈ dict[str, object] ← read(uid_path)
                uid ← int(uid_record["last_uid"])
            uid ← uid + 1
            if uid > 600000:
                raise ValueError("WORKER_UID_POOL_EXHAUSTED")
            atomic(uid_path, {"last_uid": uid})
        result["worker_uid"] ← uid
        started ∈ float ← time.monotonic()
        try:
            for stage in stages:
                now_before ∈ float ← time.monotonic()
                elapsed_before ∈ float ← now_before - started
                if elapsed_before > 120.0:
                    raise RuntimeError("RUN_BOUND_EXCEEDED")
                check_id ∈ str ← str(stage["check_id"])
                stage["state"] ← "RUNNING"
                stage["started_at"] ← time.time()
                atomic(result_path, result)
                if check_id == "prepare":
                    # Every .pi is checked by the qualified frontend before
                    # generator execution; full immutable identities preflighted.
                    stage["state"] ← "PASS"
                elif check_id == "generate-a" or check_id == "generate-b":
                    work ∈ str ← run + "/" + check_id + " space '"
                    Path(work).mkdir(mode=448)
                    os.chown(work, uid, uid)
                    environment ∈ dict[str, str] ← dict(config["grease_environment"])
                    environment["HOME"] ← work
                    command ∈ list[str] ← list(config["grease"])
                    command.append(str(config["generator"]))
                    for field in FIELDS:
                        command.append(str(inputs[field]))
                    code ∈ int ← bounded(command, work, environment, run + "/" + check_id + "-logs", uid, config, None)
                    stage["exit_code"] ← code
                    if code != 0:
                        raise ValueError("GENERATOR_FAILED")
                    stage["state"] ← "PASS"
                elif check_id == "determinism":
                    filename ∈ str ← "transfer-" + str(inputs["repository"]) + "-from-" + str(inputs["source_owner"]) + "-to-" + str(inputs["destination_owner"]) + ".sh"
                    candidate ∈ str ← run + "/generate-a space '/" + filename
                    second ∈ str ← run + "/generate-b space '/" + filename
                    generated ∈ bytes ← Path(candidate).read_bytes()
                    second_bytes ∈ bytes ← Path(second).read_bytes()
                    if generated != second_bytes:
                        raise ValueError("NONDETERMINISTIC_GENERATION")
                    artifact_digest ∈ str ← digest(generated)
                    stage["sha256"] ← artifact_digest
                    stage["state"] ← "PASS"
                elif check_id == "seal":
                    artifact ∈ str ← run + "/" + filename
                    seal_command ∈ list[str] ← list(config["ithon"])
                    seal_command.extend([str(config["seal_validator"]), candidate, artifact_digest, artifact])
                    code ← bounded(seal_command, run, clean_environment(), run + "/seal-logs", 0, config, None)
                    if code != 0:
                        raise ValueError("SEAL_FAILED")
                    stage["state"] ← "PASS"
                elif check_id.startswith("fixture-"):
                    mode ∈ str ← check_id[8:]
                    observation ∈ dict[str, object] ← fixture(config, inputs, artifact, mode, run, uid)
                    stage["observation"] ← observation
                    stage["state"] ← "PASS"
                elif check_id == "publish":
                    # Recheck material closure and sealed bytes at publication.
                    verify_deployment(config, diagnostic)
                    if digest(Path(artifact).read_bytes()) != artifact_digest:
                        raise ValueError("ARTIFACT_CHANGED_AFTER_CHECK")
                    accepted ∈ str ← run + "/accepted"
                    Path(accepted).mkdir(mode=448)
                    publication ∈ str ← accepted + "/" + filename
                    shutil.copyfile(artifact, publication)
                    if digest(Path(publication).read_bytes()) != artifact_digest:
                        raise ValueError("PUBLICATION_BYTE_MISMATCH")
                    result["artifacts"] ← [{"name": filename, "type": "grease-script", "size": len(generated), "sha256": artifact_digest, "scope": "generated-script-fixtures", "state": "diagnostic" if diagnostic else "accepted", "retrieval_locator": publication}]
                    result["promotion"] ← {"state": "candidate-verified" if diagnostic else "accepted", "decision_sha256": digest(encode(stages)), "trusted_identity": config["authority"]}
                    stage["state"] ← "PASS"
                stage["finished_at"] ← time.time()
                stage["implementation_sha256"] ← digest(Path(__file__).read_bytes())
                stage["contract_sha256"] ← config["contract_sha256"]
                atomic(result_path, result)
                elapsed ∈ float ← time.monotonic()
                if elapsed - started > 120.0:
                    raise RuntimeError("RUN_BOUND_EXCEEDED")
            result["status"] ← "PASS"
        except KeyboardInterrupt:
            stage["state"] ← "INTERRUPTED"
            result["status"] ← "INTERRUPTED"
            result["first_failure"] ← "INTERRUPTED"
            result["promotion"] ← {"state": "rejected", "reason": "INTERRUPTED"}
        except Exception as failure:
            stage["state"] ← "FAIL"
            result["status"] ← "FAIL"
            result["first_failure"] ← str(failure)
            result["promotion"] ← {"state": "rejected", "reason": str(failure)}
        finally:
            stage["finished_at"] ← time.time()
            result["finished_at"] ← time.time()
            atomic(result_path, result)
        return result
    finally:
        lock.close()

argv ∈ list[str] ← sys.argv
diagnostic ∈ bool ← argv[1] == "qualify"
configuration_path ∈ str ← argv[2] if diagnostic else "/etc/flexible-pipes/deployment.json"
configuration ∈ dict[str, object] ← read(configuration_path)
envelope ∈ dict[str, object] ← read(argv[4] if diagnostic else argv[2])
route ∈ str ← argv[3] if diagnostic else argv[1]
try:
    if not diagnostic:
        admission_root ∈ str ← str(configuration["state_root"]) + "/admissions"
        Path(admission_root).mkdir(mode=448, parents=True, exist_ok=True)
        admission ∈ str ← admission_root + "/" + str(uuid.uuid4())
        admission_command ∈ list[str] ← list(configuration["ithon"])
        decision ∈ str ← admission + ".json"
        admission_command.extend(["/opt/flexible-pipes/current/scripts/verify-admission.pi", configuration_path, argv[2], decision])
        verified ∈ int ← bounded(admission_command, admission_root, clean_environment(), admission, 0, configuration, None)
        if verified != 0:
            raise ValueError("SIGNED_ADMISSION_REJECTED")
        provider ∈ dict[str, object] ← read(decision)
        if provider["status"] != "PASS":
            raise ValueError("SIGNED_ADMISSION_REJECTED")
    raw ∈ bytes ← adapter(configuration, route, envelope)
    retry ∈ bool ← bool(envelope.get("retry", False))
    outcome ∈ dict[str, object] ← execute(configuration, raw, route, retry, diagnostic)
    print(json.dumps(outcome, sort_keys=True))
    sys.exit(0 if outcome["status"] == "PASS" else 1)
except Exception as failure:
    rejected ∈ dict[str, object] ← {"status": "BLOCKED", "blocker": str(failure), "artifacts": []}
    print(json.dumps(rejected))
    sys.exit(2)

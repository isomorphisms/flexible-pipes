#!/usr/bin/env grease
set -e
var root = ENV.RHS_SOURCE_ROOT
var evidence = ENV.RHS_EVIDENCE_ROOT
var profile = ENV.RHS_PROFILE_ROOT
var ithon = ENV.ITHON_ENTRYPOINT
var pipes = ENV.FLEXIBLE_PIPES_ROOT
var evaluator = "$root/examples/autogenerated/behavior-evaluation/evaluate.pi"
"$ithon" "$evaluator" check
"$ithon" "$pipes/scripts/rhs-model.pi" check
"$ithon" "$evaluator" prepare "$root" "$evidence" "$profile"
"$ithon" "$evaluator" exact "$evidence"
"$ithon" "$pipes/scripts/rhs-model.pi" "$evidence/candidate" "$evidence/model"
"$ithon" "$evaluator" grade "$evidence" "$evidence/grading/labels.tsv" "$evidence/grading/normal"
"$ithon" "$root/examples/autogenerated/behavior-evaluation/verify.pi" "$evidence"
write -- 'PASS executed experiment and evidence boundaries'

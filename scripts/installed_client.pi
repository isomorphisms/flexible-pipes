"""Verify a pinned installed transport closure before requesting an OIDC token.

A candidate manifest reports bytes, not approval. Only the separately
promoted root-owned client configuration can authorize active submission.
"""
import hashlib
import json
import os
import re
from pathlib import Path
from urllib.parse import urlsplit
from builtins import dict, list, ValueError, isinstance
from delivery import checked_release

SCRIPTS ∈ list[str] ← ["scripts/run-pipeline", "scripts/github-event.pi", "scripts/delivery.pi", "scripts/event_adapter.pi", "scripts/installed_client.pi", "scripts/registered-service.pi", "scripts/registered-execution.pi", "scripts/verify-admission.pi", "scripts/admission.pi", "scripts/registered-worker.pi", "scripts/registered-watchdog.pi"]
RUNTIME ∈ list[str] ← ["ithon/ithon_host.py", "ithon/Lib/ithon_static.py", "ithon/Lib/ithon_frontend.py", "ithon/Lib/ithon_run.py", "bin/ithon"]

def digest(payload ∈ bytes) → str:
    return hashlib.sha256(payload).hexdigest()

def fingerprint(path ∈ str) → str:
    return digest(Path(path).read_bytes())

def proper_hash(value ∈ object, length ∈ int) → bool:
    if not isinstance(value, str):
        return False
    selected ∈ str ← str(value)
    matched ∈ object ← re.fullmatch("[a-f0-9]{" + str(length) + "}", selected)
    return matched != None

def protected(path ∈ str, symlink_allowed ∈ bool) → None:
    selected ∈ Path ← Path(path)
    if not selected.is_absolute() or selected.is_symlink() and not symlink_allowed:
        raise ValueError("CLIENT_PATH_UNPROTECTED")
    resolved ∈ Path ← selected.resolve(strict=True)
    ancestors ∈ list[Path] ← list(resolved.parents)
    nodes ∈ list[Path] ← [resolved]
    nodes.extend(ancestors)
    for node in nodes:
        info ∈ object ← node.stat()
        owner ∈ int ← int(info.st_uid)
        mode ∈ int ← int(info.st_mode)
        if owner != 0 or mode & 18 != 0:
            raise ValueError("CLIENT_PATH_UNPROTECTED")

def manifest_check(root ∈ str, runtime ∈ str, expected_sha ∈ str, trusted ∈ bool) → dict[str, object]:
    if not proper_hash(expected_sha, 64):
        raise ValueError("CLIENT_MANIFEST_PIN_REQUIRED")
    manifest_path ∈ str ← root + "/manifest.json"
    if trusted:
        if root != "/opt/flexible-pipes/current" or runtime != "/opt/catfood":
            raise ValueError("CLIENT_NONCANONICAL_INSTALL")
        protected(manifest_path, False)
    raw ∈ bytes ← Path(manifest_path).read_bytes()
    if digest(raw) != expected_sha:
        raise ValueError("CLIENT_MANIFEST_CHANGED")
    manifest ∈ dict[str, object] ← json.loads(raw)
    if set(manifest) != set(["schema_version", "source_commit", "ithon_commit", "source_files", "runtime_files", "grease_sha256", "python_sha256", "state"]) or type(manifest["schema_version"]) != int or manifest["schema_version"] != 1 or manifest["state"] != "candidate-unpromoted":
        raise ValueError("CLIENT_MANIFEST_FIELDS")
    if not proper_hash(manifest["source_commit"], 40) or not proper_hash(manifest["ithon_commit"], 40):
        raise ValueError("CLIENT_SOURCE_IDENTITY")
    source_files ∈ dict[str, object] ← dict(manifest["source_files"])
    runtime_files ∈ dict[str, object] ← dict(manifest["runtime_files"])
    if set(source_files) != set(SCRIPTS) or set(runtime_files) != set(RUNTIME):
        raise ValueError("CLIENT_CLOSURE_INCOMPLETE")
    for relative in SCRIPTS:
        path ∈ str ← root + "/" + relative
        if Path(path).is_symlink() or not proper_hash(source_files[relative], 64):
            raise ValueError("CLIENT_SOURCE_PATH")
        if trusted:
            protected(path, False)
        if fingerprint(path) != source_files[relative]:
            raise ValueError("CLIENT_SOURCE_CHANGED: " + relative)
    for relative in RUNTIME:
        path ← runtime + "/" + relative
        if Path(path).is_symlink() or not proper_hash(runtime_files[relative], 64):
            raise ValueError("CLIENT_RUNTIME_PATH")
        if trusted:
            protected(path, False)
        if fingerprint(path) != runtime_files[relative]:
            raise ValueError("CLIENT_RUNTIME_CHANGED: " + relative)
    if not proper_hash(manifest["grease_sha256"], 64) or not proper_hash(manifest["python_sha256"], 64):
        raise ValueError("CLIENT_RUNTIME_PIN")
    if trusted:
        protected(runtime + "/bin/grease", True)
        protected("/usr/bin/python3", True)
    if fingerprint(runtime + "/bin/grease") != manifest["grease_sha256"]:
        raise ValueError("CLIENT_RUNTIME_CHANGED: grease_sha256")
    if fingerprint("/usr/bin/python3") != manifest["python_sha256"]:
        raise ValueError("CLIENT_RUNTIME_CHANGED: python_sha256")
    return manifest

def preflight(client ∈ dict[str, object], config_path ∈ str, root ∈ str, runtime ∈ str, trusted ∈ bool) → dict[str, object]:
    if client.get("state") != "active":
        raise ValueError("DEPLOYMENT_INACTIVE")
    required ∈ list[str] ← ["schema_version", "state", "endpoint", "ca_certificate", "ca_sha256", "accepted_release", "accepted_install_sha256", "activation_requires"]
    if set(client) != set(required) or type(client["schema_version"]) != int or client["schema_version"] != 1:
        raise ValueError("CLIENT_PROMOTION_FIELDS")
    if trusted:
        protected(config_path, False)
    url ∈ object ← urlsplit(str(client["endpoint"]))
    scheme ∈ str ← str(url.scheme)
    host ∈ str ← str(url.hostname)
    route ∈ str ← str(url.path)
    username ∈ str ← str(url.username)
    password ∈ str ← str(url.password)
    query ∈ str ← str(url.query)
    fragment ∈ str ← str(url.fragment)
    if scheme != "https" or host == "None" or route != "/v1/execute" or username != "None" or password != "None" or query != "" or fragment != "":
        raise ValueError("CLIENT_SUPERVISOR_ENDPOINT")
    certificate ∈ str ← str(client["ca_certificate"])
    if certificate == "" or Path(certificate).is_symlink() or not proper_hash(client["ca_sha256"], 64):
        raise ValueError("CLIENT_CA_PIN_REQUIRED")
    if trusted:
        protected(certificate, False)
    if fingerprint(certificate) != client["ca_sha256"]:
        raise ValueError("CLIENT_CA_CHANGED")
    release ∈ dict[str, object] ← dict(client["accepted_release"])
    checked_release(release)
    if release["authority"] != "deployed-trusted":
        raise ValueError("CLIENT_AUTHORITY_NOT_PROMOTED")
    manifest ∈ dict[str, object] ← manifest_check(root, runtime, str(client["accepted_install_sha256"]), trusted)
    if manifest["source_commit"] != release["control_commit"]:
        raise ValueError("CLIENT_CONTROL_COMMIT_MISMATCH")
    return {"status": "CLOSURE_VERIFIED", "control_commit": manifest["source_commit"], "release_sha256": release["release_sha256"], "manifest_sha256": client["accepted_install_sha256"], "endpoint": client["endpoint"]}

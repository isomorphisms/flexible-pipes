"""Stage a fixed inactive client/supervisor source closure.

The qualified operator, not this candidate installer, owns release promotion.
The explicit qualify prefix changes only disposable fixture locations.
"""
import os
import sys
import hashlib
import json
import subprocess
import ithon_frontend
from pathlib import Path
from builtins import ValueError, list, dict, FileNotFoundError, FileExistsError, Exception

argv ∈ list[str] ← sys.argv
fixture ∈ bool ← len(argv) == 5 and argv[1] == "qualify"
if not fixture and len(argv) != 3:
    raise ValueError("CLIENT_INSTALL_ARGUMENTS")
workspace ∈ str ← argv[2] if fixture else argv[1]
launcher ∈ str ← argv[3] if fixture else argv[2]
prefix ∈ str ← argv[4] if fixture else ""
if fixture:
    selected ∈ Path ← Path(prefix)
    if not selected.is_absolute() or str(selected.resolve()) == "/" or not selected.is_dir() or selected.is_symlink():
        raise ValueError("CLIENT_FIXTURE_ROOT")
uid ∈ int ← os.getuid()
if not fixture and uid != 0:
    raise ValueError("CLIENT_INSTALL_REQUIRES_ADMINISTRATIVE_CONTEXT")
if not Path(launcher).is_absolute() or not Path(launcher).is_file():
    raise ValueError("CLIENT_LAUNCHER_REQUIRED")
ithon ∈ str ← workspace + "/ithon"
fp ∈ str ← workspace + "/flexible-pipes"
destination ∈ str ← prefix + "/opt/flexible-pipes/current"
runtime ∈ str ← prefix + "/opt/catfood"
configuration ∈ str ← prefix + "/etc/flexible-pipes/client.json"
export ∈ str ← prefix + "/var/lib/flexible-pipes/export"

def revision(repo ∈ str) → str:
    observed ∈ object ← subprocess.run(["/usr/bin/git", "-C", repo, "rev-parse", "HEAD"], capture_output=True, timeout=10)
    stdout ∈ bytes ← observed.stdout
    commit ∈ str ← stdout.decode().strip()
    exit_code ∈ int ← int(observed.returncode)
    if exit_code != 0 or len(commit) != 40:
        raise ValueError("CLIENT_SOURCE_REVISION")
    return commit

def checked_blob(repo ∈ str, commit ∈ str, relative ∈ str, payload ∈ bytes) → None:
    command ∈ list[str] ← ["/usr/bin/git", "-C", repo, "show", commit + ":" + relative]
    observed ∈ object ← subprocess.run(command, capture_output=True, timeout=10)
    exit_code ∈ int ← int(observed.returncode)
    stdout ∈ bytes ← observed.stdout
    if exit_code != 0 or stdout != payload:
        raise ValueError("CLIENT_UNPUBLISHED_SOURCE: " + relative)

def digest(path ∈ str) → str:
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()

def parent_descriptor(path ∈ str, create ∈ bool) → int:
    # Walk directory descriptors, never following a route symlink. Exclusive
    # leaf creation below this descriptor cannot be redirected outside it.
    selected ∈ Path ← Path(path)
    parts ∈ list[str] ← list(selected.parts)
    if not selected.is_absolute() or parts.__contains__(".."):
        raise ValueError("CLIENT_INSTALL_UNSAFE_ROUTE: " + path)
    flags ∈ int ← int(os.O_RDONLY) | int(os.O_DIRECTORY) | int(os.O_NOFOLLOW)
    descriptor ∈ int ← os.open("/", flags)
    current_path ∈ str ← ""
    anchor ∈ str ← str(Path(prefix).resolve()) if fixture else "/"
    try:
        if not fixture:
            root_information ∈ object ← os.fstat(descriptor)
            root_owner ∈ int ← int(root_information.st_uid)
            root_permissions ∈ int ← int(root_information.st_mode)
            if root_owner != uid or root_permissions & 18 != 0:
                raise ValueError("CLIENT_INSTALL_UNSAFE_ROUTE: " + path)
        for component in parts[1:-1]:
            created ∈ bool ← False
            try:
                following ∈ int ← os.open(component, flags, dir_fd=descriptor)
            except FileNotFoundError:
                if not create:
                    os.close(descriptor)
                    return -1
                os.mkdir(component, 493, dir_fd=descriptor)
                created ← True
                following ← os.open(component, flags, dir_fd=descriptor)
            current_path ← current_path + "/" + component
            if not fixture or current_path == anchor or current_path.startswith(anchor + "/"):
                information ∈ object ← os.fstat(following)
                owner ∈ int ← int(information.st_uid)
                permissions ∈ int ← int(information.st_mode)
                if owner != uid or permissions & 18 != 0:
                    os.close(following)
                    raise ValueError("CLIENT_INSTALL_UNSAFE_ROUTE: " + path)
            if created:
                os.fchmod(following, 493)
            os.close(descriptor)
            descriptor ← following
        return descriptor
    except Exception:
        os.close(descriptor)
        raise ValueError("CLIENT_INSTALL_UNSAFE_ROUTE: " + path)

def refuse_existing(path ∈ str) → None:
    descriptor ∈ int ← parent_descriptor(path, False)
    if descriptor < 0:
        return
    try:
        leaf ∈ str ← Path(path).name
        try:
            observed ∈ object ← os.stat(leaf, dir_fd=descriptor, follow_symlinks=False)
        except FileNotFoundError:
            return
        raise ValueError("EXISTING_CLIENT_PRESERVED")
    finally:
        os.close(descriptor)

def create_directory(path ∈ str, existing_allowed ∈ bool, mode ∈ int) → None:
    descriptor ∈ int ← parent_descriptor(path, True)
    leaf ∈ str ← Path(path).name
    flags ∈ int ← int(os.O_RDONLY) | int(os.O_DIRECTORY) | int(os.O_NOFOLLOW)
    created ∈ bool ← False
    try:
        try:
            os.mkdir(leaf, 493, dir_fd=descriptor)
            created ← True
        except FileExistsError:
            if not existing_allowed:
                raise ValueError("CLIENT_INSTALL_PATH_EXISTS: " + path)
        directory ∈ int ← os.open(leaf, flags, dir_fd=descriptor)
        try:
            if created:
                os.fchmod(directory, mode)
        finally:
            os.close(directory)
    finally:
        os.close(descriptor)

def create_file(path ∈ str, payload ∈ bytes, mode ∈ int) → None:
    descriptor ∈ int ← parent_descriptor(path, False)
    if descriptor < 0:
        raise ValueError("CLIENT_INSTALL_PARENT_UNAVAILABLE: " + path)
    leaf ∈ str ← Path(path).name
    flags ∈ int ← int(os.O_WRONLY) | int(os.O_CREAT) | int(os.O_EXCL) | int(os.O_NOFOLLOW)
    try:
        try:
            output ∈ int ← os.open(leaf, flags, mode, dir_fd=descriptor)
        except FileExistsError:
            raise ValueError("CLIENT_INSTALL_LEAF_EXISTS: " + path)
        try:
            written ∈ int ← 0
            while written < len(payload):
                count ∈ int ← os.write(output, payload[written:])
                if count <= 0:
                    raise ValueError("CLIENT_INSTALL_WRITE_FAILED: " + path)
                written ← written + count
            os.fchmod(output, mode)
        finally:
            os.close(output)
    finally:
        os.close(descriptor)

def create_link(path ∈ str, target ∈ str) → None:
    descriptor ∈ int ← parent_descriptor(path, False)
    if descriptor < 0:
        raise ValueError("CLIENT_INSTALL_PARENT_UNAVAILABLE: " + path)
    leaf ∈ str ← Path(path).name
    try:
        try:
            os.symlink(target, leaf, dir_fd=descriptor)
        except FileExistsError:
            raise ValueError("CLIENT_INSTALL_LEAF_EXISTS: " + path)
    finally:
        os.close(descriptor)

# Existing configuration, candidate subtrees and unsafe routes are refused
# before candidate effects. Competing later leaves are preserved exclusively.
for path in [configuration, destination, runtime + "/bin", runtime + "/ithon/Lib", export]:
    refuse_existing(path)

source_commit ∈ str ← revision(fp)
ithon_commit ∈ str ← revision(ithon)
scripts ∈ list[str] ← ["scripts/run-pipeline", "scripts/github-event.pi", "scripts/delivery.pi", "scripts/event_adapter.pi", "scripts/installed_client.pi", "scripts/registered-service.pi", "scripts/registered-execution.pi", "scripts/verify-admission.pi", "scripts/admission.pi", "scripts/registered-worker.pi", "scripts/registered-watchdog.pi"]
ithon_files ∈ list[str] ← ["ithon_host.py", "Lib/ithon_static.py", "Lib/ithon_frontend.py", "Lib/ithon_run.py"]
source_payloads ∈ dict[str, bytes] ← {}
ithon_payloads ∈ dict[str, bytes] ← {}
for relative in scripts:
    payload ∈ bytes ← Path(fp + "/" + relative).read_bytes()
    checked_blob(fp, source_commit, relative, payload)
    if relative.endswith(".pi"):
        checked ∈ object ← ithon_frontend.check_source(payload.decode(), relative)
    source_payloads[relative] ← payload
for relative in ithon_files:
    payload ← Path(ithon + "/" + relative).read_bytes()
    checked_blob(ithon, ithon_commit, relative, payload)
    ithon_payloads[relative] ← payload
client ∈ dict[str, object] ← json.loads(Path(fp + "/deployment/client.json").read_bytes())
client["state"] ← "inactive"
client["endpoint"] ← ""
client["ca_certificate"] ← ""
empty_release ∈ dict[str, object] ← {}
client["accepted_release"] ← empty_release
client.pop("ca_sha256", None)
client.pop("accepted_install_sha256", None)
client_text ∈ str ← json.dumps(client, sort_keys=True)
client_bytes ∈ bytes ← client_text.encode()
create_directory(str(Path(configuration).parent), True, 493)
# Reserve the inactive configuration before creating the candidate source tree.
create_file(configuration, client_bytes, 292)
create_directory(destination + "/scripts", False, 493)
source_hashes ∈ dict[str, str] ← {}
for relative in scripts:
    create_file(destination + "/" + relative, source_payloads[relative], 365 if relative == "scripts/run-pipeline" else 292)
    source_hashes[relative] ← digest(destination + "/" + relative)
create_directory(runtime + "/bin", False, 493)
create_directory(runtime + "/ithon/Lib", False, 493)
runtime_hashes ∈ dict[str, str] ← {}
for relative in ithon_files:
    copied ∈ str ← runtime + "/ithon/" + relative
    create_file(copied, ithon_payloads[relative], 292)
    runtime_hashes["ithon/" + relative] ← digest(copied)
create_link(runtime + "/bin/grease", launcher)
ithon_launcher ∈ str ← "#!/opt/catfood/bin/grease\nexec /usr/bin/env -u PYTHONHOME -u PYTHONPATH /usr/bin/python3 /opt/catfood/ithon/ithon_host.py \"$@\"\n"
ithon_launcher_bytes ∈ bytes ← ithon_launcher.encode()
create_file(runtime + "/bin/ithon", ithon_launcher_bytes, 365)
runtime_hashes["bin/ithon"] ← digest(runtime + "/bin/ithon")
manifest ∈ dict[str, object] ← {"schema_version": 1, "source_commit": source_commit, "ithon_commit": ithon_commit, "source_files": source_hashes, "runtime_files": runtime_hashes, "grease_sha256": digest(launcher), "python_sha256": digest("/usr/bin/python3"), "state": "candidate-unpromoted"}
manifest_path ∈ str ← destination + "/manifest.json"
manifest_text ∈ str ← json.dumps(manifest, sort_keys=True, separators=(",", ":"))
manifest_bytes ∈ bytes ← manifest_text.encode()
create_file(manifest_path, manifest_bytes, 292)
create_directory(export, False, 1023 if not fixture else 448)
print(json.dumps({"status": "CANDIDATE_INSTALLED", "state": "inactive", "authority": "unprivileged-transport-only", "scope": "disposable-fixture" if fixture else "unpromoted-installed-candidate", "source_commit": source_commit, "ithon_commit": ithon_commit, "manifest_sha256": digest(manifest_path)}, sort_keys=True))

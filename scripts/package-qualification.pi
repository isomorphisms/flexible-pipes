"""Preserve diagnostic state even when the qualification driver fails early."""
import sys
import subprocess
import os
import hashlib
import json
from pathlib import Path
from builtins import ValueError, UnicodeDecodeError, list, dict
import uuid
argv ∈ list[str] ← sys.argv
output ∈ str ← argv[1]
exists ∈ bool ← Path(output).is_dir()
if not exists:
    raise ValueError("no qualification state was materialized")
archive ∈ str ← output + ".tar.gz"
present ∈ bool ← Path(archive).exists()
if present:
    raise ValueError("EXISTING_QUALIFICATION_EXPORT_PRESERVED")
staging ∈ Path ← Path(output + ".export-" + str(uuid.uuid4()))
staging.mkdir(mode=448)
included ∈ list[str] ← []
excluded ∈ list[str] ← []
total ← 0
# This downloadable CI path carries finite textual receipts/failure evidence.
# Raw captures, APKs, request envelopes, configurations and keys stay private.
for name in ["attempt.txt", "dispatch.stdout.json", "dispatch.stderr.bin", "boundary-sources.json", "runtime-interface-qualification.json", "ithon-interface.json", "ithon-interface.stderr.bin", "grease-interface.stdout.bin", "grease-interface.stderr.bin", "admission-interface.json", "gh-interface.json", "installed-client.json", "installed-client.stderr.bin", "tls-interface.stderr.bin"]:
    path ∈ Path ← Path(output).joinpath(name)
    exists ← path.exists()
    if exists == False:
        continue
    symbolic ∈ bool ← path.is_symlink()
    information ∈ object ← path.stat()
    links ∈ int ← information.st_nlink
    size ∈ int ← information.st_size
    regular ∈ bool ← path.is_file()
    if symbolic or regular == False or links != 1 or size > 8388608:
        excluded.append(name)
        continue
    payload ∈ bytes ← path.read_bytes()
    # A renamed installable ZIP cannot pass as a textual stdout/receipt file.
    packed ∈ bool ← payload.startswith(b"PK")
    try:
        decoded ∈ str ← payload.decode("utf-8")
    except UnicodeDecodeError:
        excluded.append(name)
        continue
    if packed or total + len(payload) > 16777216:
        excluded.append(name)
        continue
    staging.joinpath(name).write_bytes(payload)
    included.append(name)
    total ← total + len(payload)
manifest ∈ dict[str, object] ← {"scope": "qualification receipts and failure evidence; no installable deliverable", "included": included, "excluded_named_outputs": excluded, "private_classes": ["APKs", "raw captures", "configuration", "request envelopes", "keys"]}
staging.joinpath("publication.json").write_text(json.dumps(manifest, sort_keys=True))
child ∈ object ← subprocess.run(["/usr/bin/tar", "-czf", archive, "-C", str(staging), "."], env={"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8"}, timeout=30)
code ∈ int ← child.returncode
if code != 0:
    raise ValueError("qualification archive failed")
os.chmod(archive, 420)
payload ∈ bytes ← Path(archive).read_bytes()
print(json.dumps({"archive": archive, "bytes": len(payload), "sha256": hashlib.sha256(payload).hexdigest(), "scope": manifest["scope"]}))

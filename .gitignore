.flexible-pipes/
.venv/
__pycache__/
*.pyc

# Never commit model weights by accident.
*.safetensors
*.gguf
*.bin
*.pt
*.pth

# These are captured UTF-8 command streams, not executable/model binaries.
!receipts/jobicy-cli/**/*.bin
!receipts/fragment-semantics/**/*.bin

# Optional local cache roots.
models/cache/
cache/

#!/usr/bin/env grease
set -o errexit -o nounset -o pipefail
if (int($#) !== 2) { echo 'requires ABSOLUTE_FP_ROOT ABSOLUTE_NEW_CONTEXT' >&2; exit 2 }
var root = $1
var context = $2
case "$root" in /*) ;; *) exit 2 ;; esac
case "$context" in /*) ;; *) exit 2 ;; esac
test "$root" = "$(realpath -- "$root")"
test ! -e "$context"
var sources = "$root/_holomorphic"
var recipe = "$sources/kitchen/tasks/holomorphic-gpu-repair/6.grease"
var application = get(ENV, 'HOLOMORPHIC_APP_ROOT', "$sources/holomorphic")
var application_expected = get(ENV, 'HOLOMORPHIC_EXPECTED_APPLICATION_COMMIT', '')
var compiler = ENV.HOLOMORPHIC_ICK_HOST
var grease = "$sources/runtime/bin/grease"
# The engine path is provenance inside the staged Grease package, not a consumer command.
var engine = "$sources/runtime/bin/ysh"
var linker = '/usr/bin/x86_64-linux-gnu-gcc'
var python = "$(realpath -- "$(command -v python3)")"
var validator = "$(realpath -- "$(command -v glslangValidator)")"
var ike = "$sources/bin/ike"
test -s "$root/tasks/holomorphic-gpu-repair/source-pins.tsv"
test -x "$compiler"
test -x "$grease"
test -x "$engine"
test -x "$linker"
test -x "$python"
test -x "$validator"
test ! -e "$sources/bin"
mkdir "$sources/bin"
# The compiler action qualifies the exact ICK source. This is an ICK object
# followed by a declared host-driver link, never generic consumer compilation.
"$compiler" -O2 -std=c11 -Wall -Wextra -Werror -pedantic -fPIC -c \
    "$sources/ike/ike.c" -o "$sources/bin/ike.o"
"$linker" "$sources/bin/ike.o" -o "$ike"
test -x "$ike"
mkdir -m 700 "$context"
printf 'holomorphic\t%s\t%s\n' "$application" "$(git -C "$application" rev-parse HEAD)" > "$context/sources.tsv"
printf 'aici\t%s\t%s\n' "$sources/aici" "$(git -C "$sources/aici" rev-parse HEAD)" >> "$context/sources.tsv"
printf 'shader-backend\t%s\t%s\n' "$sources/backend" "$(git -C "$sources/backend" rev-parse HEAD)" >> "$context/sources.tsv"
printf 'ithon\t%s\t%s\n' "$sources/ithon" "$(git -C "$sources/ithon" rev-parse HEAD)" >> "$context/sources.tsv"
printf 'ike\t%s\t%s\n' "$sources/ike" "$(git -C "$sources/ike" rev-parse HEAD)" >> "$context/sources.tsv"
printf 'idric\t%s\t%s\n' "$sources/idric" "$(git -C "$sources/idric" rev-parse HEAD)" >> "$context/sources.tsv"
for checkout_role in holomorphic aici shader-backend ithon ike idric {
    var expected = "$(awk -F '\t' -v role="$checkout_role" '$1 == role { print $2 }' "$root/tasks/holomorphic-gpu-repair/source-pins.tsv")"
    if (checkout_role === 'holomorphic') {
        if (application_expected !== '') { setvar expected = application_expected }
    }
    var actual = "$(awk -F '\t' -v role="$checkout_role" '$1 == role { print $3 }' "$context/sources.tsv")"
    test "$expected" = "$actual"
}
printf 'grease\t%s\t%s\n' "$grease" "$(sha256sum "$grease" | cut -d ' ' -f1)" > "$context/tools.tsv"
printf 'grease-engine\t%s\t%s\n' "$engine" "$(sha256sum "$engine" | cut -d ' ' -f1)" >> "$context/tools.tsv"
printf 'ike\t%s\t%s\n' "$ike" "$(sha256sum "$ike" | cut -d ' ' -f1)" >> "$context/tools.tsv"
printf 'ithon\t%s\t%s\n' "$sources/ithon/ithon" "$(sha256sum "$sources/ithon/ithon" | cut -d ' ' -f1)" >> "$context/tools.tsv"
printf 'host-python\t%s\t%s\n' "$python" "$(sha256sum "$python" | cut -d ' ' -f1)" >> "$context/tools.tsv"
printf 'ick\t%s\t%s\n' "$compiler" "$(sha256sum "$compiler" | cut -d ' ' -f1)" >> "$context/tools.tsv"
printf 'host-linker\t%s\t%s\n' "$linker" "$(sha256sum "$linker" | cut -d ' ' -f1)" >> "$context/tools.tsv"
printf 'shader-validator\t%s\t%s\n' "$validator" "$(sha256sum "$validator" | cut -d ' ' -f1)" >> "$context/tools.tsv"
sha256sum "$recipe" "$sources/kitchen/tasks/holomorphic-gpu-repair/Ikefile" \
    "$sources/kitchen/tasks/holomorphic-gpu-repair/test-source-identity.grease" \
    "$context/sources.tsv" "$context/tools.tsv" \
    "$application/_/oracle/meromorphic_divisor_oracle.py" \
    "$application/_/oracle/test_meromorphic_divisor_oracle.py" \
    "$application/_/tests/holo-divisor-sampler.c" \
    "$application/_/tests/test-holo-divisor.c" \
    "$application/_/shader/test_runtime_source_binding.c" \
    "$application/_/shader/runtime_source_binding.h" \
    "$application/_/shader/verify_generated_source_binding.c" \
    "$application/_/shader/bind-generated-fragment.grease" \
    "$application/gpu/Example/HolomorphicLive.idr" \
    "$application/android/app/src/main/cpp/holomorphic_divisor.h" \
    "$sources/aici/examples/autogenerated/holomorphic-phase-log/HolomorphicAcceptance.pi" \
    > "$context/materials.sha256"
sha256sum "$sources/bin/ike.o" "$ike" > "$context/ike-build.sha256"
printf '\033[32mPASS\033[0m fresh pinned run handoff and ICK-built Ike\n'

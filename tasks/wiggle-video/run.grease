#!/usr/bin/env grease
set -o errexit -o nounset -o pipefail
if (int($#) !== 5) { echo 'requires PHASE CONTROL_ROOT CONTEXT INPUTS OUTPUT' >&2; exit 2 }
var phase = $1
var root = $2
var context = $3
var inputs = $4
var output = $5
for path in "$root" "$context" "$inputs" "$output" {
    case "$path" in /*) ;; *) echo 'absolute paths required' >&2; exit 2 ;; esac
}
test "$root" = "$(realpath -- "$root")"
test "$(realpath -- "$0")" = "$root/tasks/wiggle-video/run.grease"
git -C "$root" diff --quiet HEAD --
var ithon = "$(awk -F '\t' '$1 == "ithon" { print $2 }' "$context")"
var aici = "$(awk -F '\t' '$1 == "aici" { print $2 }' "$context")"
var compiler = "$(awk -F '\t' '$1 == "ick" { print $2 }' "$context")"
var adapters = "$(awk -F '\t' '$1 == "adapters" { print $2 }' "$context")"
test "$adapters" = "$root/examples/autogenerated/timed-inputs"
var expected_aici = "$(awk -F '\t' '$1 == "aici" { print $3 }' "$root/tasks/wiggle-video/source-pins.tsv")"
test -x "$ithon"
test -x "$compiler"
test "$(git -C "$aici" rev-parse HEAD)" = "$expected_aici"
git -C "$aici" diff --quiet HEAD --
var code = "$root/examples/autogenerated/timed-inputs"
setglobal ENV.ITHON_CHECK_RECEIPT = "$output.ithon-checks.jsonl"
case "$phase" in
    timeline-tests)
        "$ithon" "$code/test-timeline.pi" "$root/tasks/wiggle-video/examples"
        var mathieu = "$(awk -F '\t' '$1 == "mathieu" { print $2 }' "$context")"
        "$compiler" -fno-link-libatomic -std=c17 -O2 -Wall -Wextra -Werror \
            "$mathieu/native/mathieu.c" "$mathieu/native/session.c" \
            "$mathieu/native/render.c" "$mathieu/tests/render-policy.c" -lm -o "$output.render-policy"
        "$output.render-policy"
        ;;
    produce)
        "$ithon" "$code/drive.pi" produce "$context" "$inputs" "$output"
        ;;
    independent)
        "$compiler" -fno-link-libatomic -std=c17 -O2 -Wall -Wextra -Werror -pedantic \
            "$aici/src/aici_video.c" -lm -o "$output/aici-video"
        "$ithon" "$aici/wiggle/verify.pi" "$context" "$inputs" "$output"
        ;;
    adversarial)
        "$ithon" "$aici/wiggle/test-mutants.pi" "$context" "$inputs" "$output"
        "$ithon" "$code/test-failures.pi" "$context" "$output"
        ;;
    seal)
        "$ithon" "$code/drive.pi" seal "$context" "$inputs" "$output"
        ;;
    *) echo 'unknown WIGGLE phase' >&2; exit 2 ;;
esac

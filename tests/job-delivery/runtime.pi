"""Exercise actual delivery effects, ordering, recovery and pipeline adoption."""
import os
import sys
import json
import subprocess
import tempfile
from pathlib import Path
from types import SimpleNamespace
from builtins import dict, list, ValueError, Exception, AssertionError
import handoff
import job_delivery

args ∈ list[str] ← sys.argv
root ∈ Path ← Path(args[1]).resolve()
ithon ∈ str ← args[2]
effects ∈ list[str] ← []
captured ∈ list[bytes] ← []
mutation ∈ str ← "none"
passed_cases ∈ list[str] ← []

def surface_send(response ∈ bytes) → dict[str, object]:
    effects.append("visible")
    actual ∈ bytes ← response
    if mutation == "summary":
        actual ← b"The job exists.\n"
    elif mutation == "truncate":
        actual ← response[:-25]
    captured.append(actual)
    return {"bytes": actual, "message_id": "fixture-message", "surface": "fixture-visible-chat"}

def dispatch_send(payload ∈ bytes, payload_id ∈ str) → dict[str, object]:
    effects.append("dispatch")
    actual ∈ bytes ← payload + b"changed\n" if mutation == "dispatch" else payload
    return {"bytes": actual, "dispatch_id": payload_id}

def fresh(payload ∈ bytes, mode ∈ str) → dict[str, object]:
    request ∈ dict[str, object] ← {"id": "oct6-fixture", "text": "Make a Sun job", "delivery_mode": mode}
    if mode != "display-only":
        request["explicit_mode"] ← mode
        request["source"] ← "human"
    if mode == "dispatch-only":
        request["text"] ← "Dispatch only; execute directly."
    stage ∈ dict[str, object] ← {"name": "assignment", "kind": "command", "exit_code": 0, "stdout_sha256": handoff.digest(payload)}
    spec ∈ dict[str, object] ← {"audience": "Sun", "model": "selected-Sun-model", "source_context": "sanitized October 6 recurrence", "request": request}
    return handoff.compose(stage, payload, spec)

def passed(name ∈ str) → None:
    passed_cases.append(name)
    print("PASS " + name)

sink ∈ object ← SimpleNamespace(send=surface_send)
dispatcher ∈ object ← SimpleNamespace(send=dispatch_send)
gate ∈ object ← SimpleNamespace(check=job_delivery.check)
for fixture in ["young-tableaux", "a1-c67"]:
    payload ∈ bytes ← Path(str(root) + "/regressions/job-delivery/" + fixture + ".txt").read_bytes()
    for mode in ["display-only", "display-and-dispatch", "dispatch-only"]:
        effects.clear()
        captured.clear()
        stage ∈ dict[str, object] ← fresh(payload, mode)
        delivered ∈ dict[str, object] ← handoff.deliver(stage, payload, sink, dispatcher, gate, "Complete assignment follows.")
        wanted ∈ list[str] ← ["dispatch"] if mode == "dispatch-only" else ["visible"] if mode == "display-only" else ["visible", "dispatch"]
        if effects != wanted or delivered["delivery_status"] != "PASS":
            raise AssertionError("wrong effect order")
        passed(fixture + " " + mode)
    for bad in ["summary", "truncate", "dispatch"]:
        mutation ← bad
        effects.clear()
        caught ∈ bool ← False
        try:
            handoff.deliver(fresh(payload, "display-and-dispatch"), payload, sink, dispatcher, gate, "")
        except ValueError:
            caught ← True
        if not caught or (bad != "dispatch" and effects.__contains__("dispatch")):
            raise AssertionError("bad surface reached dispatch")
        passed(fixture + " reject " + bad)
    mutation ← "none"
    effects.clear()
    captured.clear()
    delivered ← handoff.deliver(fresh(payload, "display-and-dispatch"), payload, sink, dispatcher, gate, "")
    recovered ∈ dict[str, object] ← handoff.recover(delivered, "Where’s the text?")
    delivered ← handoff.deliver(recovered, payload, sink, dispatcher, gate, "Recovered assignment follows.")
    if effects != ["visible", "dispatch", "visible"]:
        raise AssertionError("recovery dispatched twice")
    old ∈ dict[str, object] ← dict(recovered["handoff"])
    new ∈ dict[str, object] ← dict(delivered["handoff"])
    if old["id"] != new["id"] or len(list(new["events"])) != 4:
        raise AssertionError("recovery lost identity/failure")
    passed(fixture + " recovered without redispatch")
    response ∈ bytes ← captured[-1]
    packet ∈ dict[str, object] ← handoff.review_packet(delivered, payload, response, "Make a Sun job", "Where’s the text?", gate)
    reviewer ∈ dict[str, object] ← {"identity": "fixture-reviewer", "revision": "fixture-revision", "prompt": "Check actual assignment and response", "raw_response": "deliver: complete visible assignment", "reason": "full assignment present", "decision": "deliver"}
    review ∈ dict[str, object] ← handoff.review_decision(packet, reviewer)
    if review["decision"] != "deliver":
        raise AssertionError("positive review failed")
    caught ← False
    try:
        handoff.review_packet(fresh(payload, "display-only"), payload, b"The job exists.\n", "Make a job", "", gate)
    except ValueError:
        caught ← True
    if not caught:
        raise AssertionError("review bypassed deterministic failure")
    passed(fixture + " review rejects hidden artifact")

# Exercise the real maintained runner, not only library functions. A later
# command would write a marker; pending delivery must prevent that effect.
with tempfile.TemporaryDirectory(prefix="job-delivery-") as temporary:
    work ∈ str ← str(temporary)
    marker ∈ str ← work + "/should-not-dispatch"
    pipeline ∈ Path ← Path(str(root) + "/pipelines/test-job-delivery.json")
    payload ← Path(str(root) + "/regressions/job-delivery/young-tableaux.txt").read_bytes()
    spec ∈ dict[str, object] ← {"audience": "Sun", "model": "fixture", "source_context": "fixture", "request": {"id": "runner-fixture", "text": "Write the Sun job"}}
    stages ∈ list[dict[str, object]] ← [{"name": "assignment", "kind": "command", "argv": ["cat", str(root) + "/regressions/job-delivery/young-tableaux.txt"], "handoff": spec}, {"name": "dispatch", "kind": "command", "argv": ["touch", marker]}]
    plan ∈ dict[str, object] ← {"schema_version": 1, "name": "test-job-delivery", "stages": stages}
    try:
        pipeline.write_text(json.dumps(plan))
        child ∈ object ← subprocess.run([sys.executable, str(root) + "/scripts/run-pipeline", "test-job-delivery", "--ithon", ithon, "--runs-root", work + "/runs"], capture_output=True)
        result ∈ dict[str, object] ← json.loads(child.stdout)
        if int(child.returncode) == 0 or result["status"] != "AWAITING_HANDOFF_DELIVERY" or bool(Path(marker).exists()):
            raise AssertionError("internal composition passed/delivered/dispatched")
        passed("real pipeline holds at delivery boundary")
        spec["unknown_policy"] ← "unsafe"
        pipeline.write_text(json.dumps(plan))
        child ← subprocess.run([sys.executable, str(root) + "/scripts/run-pipeline", "test-job-delivery", "--ithon", ithon, "--runs-root", work + "/invalid-runs"], capture_output=True)
        if int(child.returncode) == 0 or bool(Path(marker).exists()) or bool(Path(work + "/invalid-runs").exists()):
            raise AssertionError("invalid handoff reached effects")
        passed("real pipeline prevalidates handoff before effects")
    finally:
        pipeline.unlink(missing_ok=True)
print("runtime cases PASS: " + str(len(passed_cases)))

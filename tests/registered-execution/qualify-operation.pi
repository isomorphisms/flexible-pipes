"""Materialize diagnostic deployment and exercise the public adapters.

No credentials, model, downloads, installation, or publishing authority.
Output directories must be new; every failed attempt is retained.
"""
import json
import os
import sys
import subprocess
import hashlib
import time
import shutil
import uuid
from pathlib import Path
from builtins import dict, list, open, ValueError

argv ∈ list[str] ← sys.argv
workspace ∈ str ← argv[1]
output ∈ str ← argv[2]
Path(output).mkdir(mode=493, parents=True, exist_ok=False)
Path(output + "/attempt.txt").write_text("qualification started; no deployment authority\n")
fp ∈ str ← workspace + "/flexible-pipes"
ithon ∈ str ← workspace + "/ithon"
kitchen ∈ str ← workspace + "/kitchen"
aici ∈ str ← workspace + "/ai-ci"
catfood ∈ str ← workspace + "/catfood"
grease_source ∈ str ← argv[3] if len(argv) > 3 else "/workspace/scratch/af185923d929/grease/source"
grease_launcher ∈ str ← argv[4] if len(argv) > 4 else "/workspace/scratch/af185923d929/runtime/grease"
python ∈ str ← argv[5] if len(argv) > 5 else "/opt/codex/runtimes/codex-primary-runtime/dependencies/python/bin/python3"
grease_python ∈ str ← argv[6] if len(argv) > 6 else grease_source + "/Python-2.7.13/python"
grease_entry ∈ str ← grease_source + "/bin/oils_for_unix.py"
ithon_command ∈ list[str] ← [python, ithon + "/ithon_host.py"]
environment ∈ dict[str, str] ← {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "HOME": "/nonexistent", "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_NOSYSTEM": "1", "GIT_NO_REPLACE_OBJECTS": "1"}
grease_environment ∈ dict[str, str] ← dict(environment)
grease_environment["PYTHONPATH"] ← grease_source + ":" + grease_source + "/vendor"
grease ∈ list[str] ← [grease_python, grease_entry, "ysh"]

def digest(path ∈ str) → str:
    answer ∈ str ← hashlib.sha256(Path(path).read_bytes()).hexdigest()
    return answer

def write(path ∈ str, value ∈ object) → None:
    text ∈ str ← json.dumps(value, sort_keys=True, separators=(",", ":"))
    Path(path).write_text(text)

def git(repo ∈ str, args ∈ list[str]) → str:
    command ∈ list[str] ← ["/usr/bin/git", "--no-replace-objects", "-c", "safe.directory=" + repo, "-C", repo]
    command.extend(args)
    process ∈ object ← subprocess.run(command, env=environment, capture_output=True, check=True, timeout=15)
    result ∈ bytes ← process.stdout
    return result.decode().strip()

def run_case(name ∈ str, candidate ∈ dict[str, object], route ∈ str, admission ∈ dict[str, object], expected ∈ str, failure ∈ str) → dict[str, object]:
    directory ∈ str ← output + "/cases/" + name
    Path(directory).mkdir(mode=493, parents=True, exist_ok=False)
    write(directory + "/deployment.json", candidate)
    write(directory + "/envelope.json", admission)
    command ∈ list[str] ← list(ithon_command)
    command.extend([fp + "/scripts/registered-execution.pi", "qualify", directory + "/deployment.json", route, directory + "/envelope.json"])
    with open(directory + "/stdout.json", "xb") as out:
        with open(directory + "/stderr.bin", "xb") as err:
            child ∈ object ← subprocess.run(command, env=environment, stdout=out, stderr=err, timeout=130)
    result ∈ dict[str, object] ← json.loads(Path(directory + "/stdout.json").read_bytes())
    if result["status"] != expected:
        raise ValueError("unexpected case outcome: " + name)
    detail ∈ str ← str(result.get("blocker", result.get("first_failure", "")))
    if failure != "" and not detail.startswith(failure):
        raise ValueError("wrong failure: " + name + ": " + detail)
    write(directory + "/check.json", {"case": name, "status": "PASS", "operation_status": expected, "failure": detail})
    return result

def copy_object(value ∈ dict[str, object]) → dict[str, object]:
    result ∈ dict[str, object] ← json.loads(json.dumps(value))
    return result

def request_commit(mirror ∈ str, base ∈ str, request ∈ dict[str, object], changed_code ∈ str) → str:
    # An object-only fixture. No checkout, hooks, reset, clean or user edit.
    payload ∈ str ← json.dumps(request, sort_keys=True)
    child ∈ object ← subprocess.run(["/usr/bin/git", "-C", mirror, "hash-object", "-w", "--stdin"], input=payload.encode(), env=environment, capture_output=True, check=True)
    blob_bytes ∈ bytes ← child.stdout
    blob ∈ str ← blob_bytes.decode().strip()
    request_tree ∈ str ← "100644 blob " + blob + "\tqualification.json\n"
    child ← subprocess.run(["/usr/bin/git", "-C", mirror, "mktree"], input=request_tree.encode(), env=environment, capture_output=True, check=True)
    tree_bytes ∈ bytes ← child.stdout
    requests_tree ∈ str ← tree_bytes.decode().strip()
    listing ∈ str ← git(mirror, ["ls-tree", base])
    rows ∈ list[str] ← listing.splitlines()
    new_listing ∈ str ← ""
    for row in rows:
        if not row.endswith("\trequests"):
            new_listing ← new_listing + row + "\n"
    new_listing ← new_listing + "040000 tree " + requests_tree + "\trequests\n"
    if changed_code != "":
        new_listing ← new_listing + "100644 blob " + blob + "\taltered-control-code.pi\n"
    child ← subprocess.run(["/usr/bin/git", "-C", mirror, "mktree"], input=new_listing.encode(), env=environment, capture_output=True, check=True)
    root_bytes ∈ bytes ← child.stdout
    root_tree ∈ str ← root_bytes.decode().strip()
    identity ∈ dict[str, str] ← dict(environment)
    identity["GIT_AUTHOR_NAME"] ← "Disposable fixture"
    identity["GIT_AUTHOR_EMAIL"] ← "fixture@example.invalid"
    identity["GIT_COMMITTER_NAME"] ← "Disposable fixture"
    identity["GIT_COMMITTER_EMAIL"] ← "fixture@example.invalid"
    child ← subprocess.run(["/usr/bin/git", "-C", mirror, "commit-tree", root_tree, "-p", base, "-m", "Data-only intake fixture"], env=identity, capture_output=True, check=True)
    commit_bytes ∈ bytes ← child.stdout
    return commit_bytes.decode().strip()

materials ∈ list[dict[str, object]] ← []
repositories ∈ list[dict[str, object]] ← [
    {"checkout": fp, "files": ["scripts/registered-execution.pi", "scripts/registered-worker.pi", "registry/kitchen-transfer-script.contract.json", "tests/registered-execution/qualify-operation.pi"], "ref": "origin/implement/fp2-runtime-qualification"},
    {"checkout": kitchen, "files": ["tasks/github-repository-transfer/generate-transfer-github-repository-script.sh", "tasks/github-repository-transfer/5.sh", "tasks/github-repository-transfer/fixture-api.pi", "tasks/github-repository-transfer/fixture-gh.pi", "tests/qualify-transfer-artifact.pi"], "ref": "origin/fp2/qualified-transfer-generator"},
    {"checkout": aici, "files": ["validators/kitchen-transfer-script.pi"], "ref": "origin/fp2/transfer-observation-validator"},
    {"checkout": catfood, "files": ["acceptance/sealed-script.pi"], "ref": "origin/fp2/sealed-script-validation"},
    {"checkout": ithon, "files": ["ithon_host.py", "Lib/ithon_frontend.py", "Lib/ithon_static.py", "Lib/ithon_run.py", "tests/qualify-host-control.pi", "Lib/test/test_ithon_static.py", "Lib/test/test_ithon_static_unicode.py", "Lib/test/test_ithon_run.py", "Lib/test/test_ithon_control.py"], "ref": "origin/fp2/control-interface-support"},
]
for repository in repositories:
    checkout ∈ str ← str(repository["checkout"])
    commit ∈ str ← git(checkout, ["rev-parse", "HEAD"])
    origin ∈ str ← git(checkout, ["config", "--local", "--get", "remote.origin.url"])
    files ∈ list[str] ← list(repository["files"])
    for relative in files:
        path ∈ str ← checkout + "/" + relative
        materials.append({"path": path, "checkout": checkout, "relative_path": relative, "commit": commit, "origin": origin, "published_ref": repository["ref"], "sha256": digest(path)})

tools ∈ list[dict[str, object]] ← []
for path in [python, grease_python, grease_entry, "/usr/bin/git", "/usr/bin/grep", "/usr/bin/dirname", "/usr/bin/chmod", "/usr/bin/cat", "/lib/x86_64-linux-gnu/libseccomp.so.2"]:
    tools.append({"path": path, "sha256": digest(path)})
# Bind the actual interpreted Grease dependency closure, including generated
# modules and native extensions, rather than treating a launcher as identity.
runtime_files ∈ list[Path] ← list(Path(grease_source).rglob("*.py"))
runtime_files.extend(list(Path(grease_source).rglob("*.so")))
for runtime_file in runtime_files:
    tools.append({"path": str(runtime_file), "sha256": digest(str(runtime_file))})
# Never widen runner-home permissions to make a worker read source. Materialize
# read-only runtime/source copies in this attempt's public, root-owned release.
release ∈ str ← "/tmp/fp2-release-" + str(uuid.uuid4())
Path(release).mkdir(mode=493)
runtime_ithon ∈ str ← release + "/ithon"
Path(runtime_ithon + "/Lib").mkdir(mode=493, parents=True)
for relative in ["ithon_host.py", "Lib/ithon_static.py", "Lib/ithon_frontend.py", "Lib/ithon_run.py"]:
    copied ∈ str ← runtime_ithon + "/" + relative
    shutil.copyfile(ithon + "/" + relative, copied)
    tools.append({"path": copied, "sha256": digest(copied)})
ithon_command ← [python, runtime_ithon + "/ithon_host.py"]
runtime_grease ∈ str ← release + "/grease-source"
shutil.copytree(grease_source, runtime_grease, ignore=shutil.ignore_patterns(".git", "*.pyc", "*.o", "*.a"))
runtime_python ∈ str ← release + "/python2"
shutil.copyfile(grease_python, runtime_python)
os.chmod(runtime_python, 365)
prefix ∈ str ← release + "/python-prefix"
shutil.copytree(grease_source + "/Python-2.7.13/Lib", prefix + "/lib/python2.7")
extension_dirs ∈ list[Path] ← list(Path(grease_python).parent.glob("build/lib.*"))
if len(extension_dirs) != 1:
    raise ValueError("ambiguous Python 2 extension directory")
shutil.copytree(str(extension_dirs[0]), prefix + "/lib/python2.7/lib-dynload")
grease_environment["PYTHONHOME"] ← prefix
grease_environment["PYTHONPATH"] ← runtime_grease + ":" + runtime_grease + "/vendor"
grease ← [runtime_python, runtime_grease + "/bin/oils_for_unix.py", "ysh"]
runtime_materials ∈ list[dict[str, object]] ← []
for material in materials:
    relative ∈ str ← str(material["relative_path"])
    if relative.endswith(".pi") or relative.endswith(".sh"):
        copied ← release + "/" + relative
        Path(copied).parent.mkdir(mode=493, parents=True, exist_ok=True)
        shutil.copyfile(str(material["path"]), copied)
        record ∈ dict[str, object] ← dict(material)
        record["path"] ← copied
        runtime_materials.append(record)
materials.extend(runtime_materials)
runtime_files ← list(Path(release).rglob("*.py"))
runtime_files.extend(list(Path(release).rglob("*.so")))
runtime_files.append(Path(runtime_python))
for runtime_file in runtime_files:
    tools.append({"path": str(runtime_file), "sha256": digest(str(runtime_file))})
bin_dir ∈ str ← output + "/fixture-bin"
Path(bin_dir).mkdir(mode=493)
bridge ∈ str ← bin_dir + "/gh"
runtime_launcher ∈ str ← release + "/grease"
# Cat Food's existing source launcher is runtime plumbing. Bind its byte-for-
# byte copy plus rewritten fixed runtime locations, never another shell.
launcher_text ∈ str ← Path(grease_launcher).read_text()
launcher_text ← launcher_text.replace(grease_python, runtime_python).replace(grease_source, runtime_grease)
Path(runtime_launcher).write_text(launcher_text)
os.chmod(runtime_launcher, 365)
tools.append({"path": runtime_launcher, "sha256": digest(runtime_launcher)})
bridge_text ∈ str ← "#!" + runtime_launcher + "\nexec /usr/bin/env -u PYTHONHOME -u PYTHONPATH " + python + " " + runtime_ithon + "/ithon_host.py " + release + "/tasks/github-repository-transfer/fixture-gh.pi \"$@\"\n"
Path(bridge).write_text(bridge_text)
os.chmod(bridge, 365)
tools.append({"path": bridge, "sha256": digest(bridge)})
tools.append({"path": grease_launcher, "sha256": digest(grease_launcher)})
contract_path ∈ str ← fp + "/registry/kitchen-transfer-script.contract.json"
contract ∈ dict[str, object] ← json.loads(Path(contract_path).read_bytes())
encoded_materials ∈ str ← json.dumps(materials, sort_keys=True, separators=(",", ":"))
closure ∈ str ← hashlib.sha256(encoded_materials.encode()).hexdigest()
qualification_path ∈ str ← output + "/runtime-interface-qualification.json"
host_command ∈ list[str] ← [python, ithon + "/ithon_host.py", ithon + "/tests/qualify-host-control.pi", output + "/ithon-interface.json"]
with open(output + "/ithon-interface.stderr.bin", "xb") as host_log:
    host_process ∈ object ← subprocess.run(host_command, env=environment, stderr=host_log, stdout=subprocess.DEVNULL, timeout=30)
host_result ∈ dict[str, object] ← json.loads(Path(output + "/ithon-interface.json").read_bytes())
host_exit ∈ int ← host_process.returncode
if host_exit != 0 or host_result["status"] != "PASS" or host_result["skipped"] != 0:
    raise ValueError("ITHON_INTERFACE_UNQUALIFIED")
smoke ∈ list[str] ← list(grease)
smoke.extend(["-c", 'var answer = 6 * 7; write -- "grease=$answer"; false ∨ echo canonical-grease'])
smoke_process ∈ object ← subprocess.run(smoke, env=grease_environment, capture_output=True, timeout=15)
smoke_bytes ∈ bytes ← smoke_process.stdout
smoke_exit ∈ int ← smoke_process.returncode
if smoke_exit != 0 or smoke_bytes != b"grease=42\ncanonical-grease\n":
    raise ValueError("GREASE_INTERFACE_UNQUALIFIED")
Path(output + "/grease-interface.stdout.bin").write_bytes(smoke_bytes)
Path(output + "/grease-interface.stderr.bin").write_bytes(smoke_process.stderr)
write(qualification_path, {"schema_version": 1, "status": "PASS", "scope": "local-qualification", "materials_sha256": closure, "tools_sha256": hashlib.sha256(json.dumps(tools, sort_keys=True, separators=(",", ":")).encode()).hexdigest(), "environment_sha256": hashlib.sha256(json.dumps(grease_environment, sort_keys=True, separators=(",", ":")).encode()).hexdigest(), "ithon_evidence_sha256": digest(output + "/ithon-interface.json"), "grease_evidence_sha256": digest(output + "/grease-interface.stdout.bin"), "excluded_claims": ["operation-qualified-before-this-run", "deployment"]})
config ∈ dict[str, object] ← {"schema_version": 1, "operation": "kitchen-transfer-script", "operation_version": "2", "registry_generation": 1, "qualified": True, "authority": "local-qualification", "required_checks": contract["required_checks"], "materials": materials, "tools": tools, "contract": contract_path, "contract_sha256": digest(contract_path), "qualification": qualification_path, "qualification_sha256": digest(qualification_path), "control_commit": git(fp, ["rev-parse", "HEAD"]), "state_root": output + "/state", "request_mirror": fp, "request_base": git(fp, ["rev-parse", "HEAD"]), "ithon": ithon_command, "grease": grease, "grease_environment": grease_environment, "worker": release + "/scripts/registered-worker.pi", "generator": release + "/tasks/github-repository-transfer/generate-transfer-github-repository-script.sh", "fixture_server": kitchen + "/tasks/github-repository-transfer/fixture-api.pi", "fixture_bin": bin_dir, "api_validator": aici + "/validators/kitchen-transfer-script.pi", "seal_validator": catfood + "/acceptance/sealed-script.pi"}
config_path ∈ str ← output + "/candidate-deployment.json"
write(config_path, config)
inputs ∈ dict[str, object] ← {"source_owner": "source", "repository": "sample", "destination_owner": "destination", "expected_login": "login", "expected_repository_id": 123, "target_context": "linux-x86_64-grease-v1"}
request ∈ dict[str, object] ← {"schema_version": 1, "request_id": "qualification-dispatch", "pipeline": "kitchen-transfer-script", "inputs": inputs}
request_text ∈ str ← json.dumps(request, sort_keys=True)
envelope ∈ dict[str, object] ← {"workflow_ref": "refs/heads/main", "workflow_sha": config["control_commit"], "repository_id": 1405888814, "request": request_text}
envelope_path ∈ str ← output + "/dispatch-envelope.json"
write(envelope_path, envelope)
command ∈ list[str] ← list(ithon_command)
command.extend([fp + "/scripts/registered-execution.pi", "qualify", config_path, "workflow_dispatch", envelope_path])
with open(output + "/dispatch.stdout.json", "xb") as out:
    with open(output + "/dispatch.stderr.bin", "xb") as err:
        process ∈ object ← subprocess.run(command, env=environment, stdout=out, stderr=err, timeout=130)
code ∈ int ← process.returncode
result ∈ dict[str, object] ← json.loads(Path(output + "/dispatch.stdout.json").read_bytes())
print(json.dumps({"status": result.get("status"), "first_failure": result.get("first_failure"), "blocker": result.get("blocker")}))
if code == 0:
    # Duplicate submission returns its original attempt; retries create a new
    # one without touching the earlier journal/artifact.
    duplicate ∈ dict[str, object] ← run_case("duplicate", config, "workflow_dispatch", envelope, "PASS", "")
    if duplicate["run_id"] != result["run_id"]:
        raise ValueError("duplicate created another run")
    for field in ["shell", "argv", "environment", "compiler", "interpreter", "signer", "policy"]:
        bad_request ∈ dict[str, object] ← copy_object(request)
        bad_request[field] ← "forbidden"
        bad_envelope ∈ dict[str, object] ← copy_object(envelope)
        bad_envelope["request"] ← json.dumps(bad_request)
        run_case("executable-" + field, config, "workflow_dispatch", bad_envelope, "BLOCKED", "REQUEST_FIELDS")
    bad_request ← copy_object(request)
    bad_request["pipeline"] ← "unknown"
    bad_envelope ← copy_object(envelope)
    bad_envelope["request"] ← json.dumps(bad_request)
    run_case("unknown-operation", config, "workflow_dispatch", bad_envelope, "BLOCKED", "UNKNOWN_OPERATION")
    bad_envelope ← copy_object(envelope)
    bad_envelope["workflow_ref"] ← "refs/heads/old-workflow"
    run_case("old-workflow", config, "workflow_dispatch", bad_envelope, "BLOCKED", "UNQUALIFIED_WORKFLOW_REF")
    bad_config ∈ dict[str, object] ← copy_object(config)
    bad_config["qualified"] ← False
    run_case("unqualified", bad_config, "workflow_dispatch", envelope, "BLOCKED", "UNQUALIFIED_ADAPTER")
    bad_config ← copy_object(config)
    bad_checks ∈ list[str] ← list(contract["required_checks"])
    bad_checks.remove("prepare")
    bad_config["required_checks"] ← bad_checks
    run_case("omitted-preparation", bad_config, "workflow_dispatch", envelope, "BLOCKED", "MANDATORY_CHILD_MISSING")
    bad_config ← copy_object(config)
    bad_checks ← list(contract["required_checks"])
    bad_checks.remove("fixture-personal")
    bad_config["required_checks"] ← bad_checks
    run_case("omitted-child", bad_config, "workflow_dispatch", envelope, "BLOCKED", "MANDATORY_CHILD_MISSING")
    changed_request ∈ dict[str, object] ← copy_object(request)
    changed_inputs ∈ dict[str, object] ← dict(changed_request["inputs"])
    changed_inputs["repository"] ← "other"
    changed_request["inputs"] ← changed_inputs
    bad_envelope ← copy_object(envelope)
    bad_envelope["request"] ← json.dumps(changed_request, sort_keys=True)
    run_case("duplicate-different-bytes", config, "workflow_dispatch", bad_envelope, "BLOCKED", "DUPLICATE_ID_DIFFERENT_BYTES")
    mirror ∈ str ← output + "/request-mirror.git"
    git(fp, ["clone", "--bare", "--no-hardlinks", fp, mirror])
    branch_config ∈ dict[str, object] ← copy_object(config)
    branch_config["request_mirror"] ← mirror
    branch_request ∈ dict[str, object] ← copy_object(request)
    branch_request["request_id"] ← "qualification-request-branch"
    branch_head ∈ str ← request_commit(mirror, str(config["request_base"]), branch_request, "")
    branch_envelope ∈ dict[str, object] ← {"request_commit": branch_head}
    branch_result ∈ dict[str, object] ← run_case("request-branch-positive", branch_config, "pipeline-requests", branch_envelope, "PASS", "")
    dirty_file ∈ str ← output + "/preserved-dirty.txt"
    Path(dirty_file).write_text("unchanged user work\n")
    altered_head ∈ str ← request_commit(mirror, str(config["request_base"]), branch_request, "altered")
    branch_envelope["request_commit"] ← altered_head
    run_case("request-branch-control-change", branch_config, "pipeline-requests", branch_envelope, "BLOCKED", "NON_REQUEST_CHANGE")
    dirty_bytes ∈ bytes ← Path(dirty_file).read_bytes()
    if dirty_bytes != b"unchanged user work\n":
        raise ValueError("dirty state changed")
    # Both positive routes executed the real recipe and return identical bytes.
    dispatch_artifacts ∈ list[dict[str, object]] ← list(result["artifacts"])
    branch_artifacts ∈ list[dict[str, object]] ← list(branch_result["artifacts"])
    if dispatch_artifacts[0]["sha256"] != branch_artifacts[0]["sha256"]:
        raise ValueError("route artifact mismatch")
    write(output + "/both-routes.json", {"status": "PASS", "dispatch_run": result["run_id"], "request_branch_run": branch_result["run_id"], "artifact_sha256": dispatch_artifacts[0]["sha256"], "scope": "hosted-candidate-adapter-qualification", "deployment": "inactive"})
failure_logs ∈ list[Path] ← list(Path(output).rglob("*stderr.bin"))
for failure_log in failure_logs:
    message ∈ bytes ← failure_log.read_bytes()
    if len(message) > 0:
        print(str(failure_log), message[:32768].decode(errors="replace"))
archive ∈ str ← output + ".tar.gz"
packaged ∈ object ← subprocess.run(["/usr/bin/tar", "-czf", archive, "-C", output, "."], env=environment, timeout=20)
os.chmod(archive, 420)
print(json.dumps({"exit_code": code, "output": output, "result": output + "/dispatch.stdout.json"}))
sys.exit(code)

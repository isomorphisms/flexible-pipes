"""TLS fixtures exercise the separate supervisor and exact-byte client delivery."""
import sys
import os
import json
import time
import subprocess
import signal
import hashlib
import importlib
import base64
from pathlib import Path
from builtins import dict, list, open, ValueError, ProcessLookupError
argv ∈ list[str] ← sys.argv
workspace ∈ str ← argv[1]
output ∈ str ← argv[2]
sys.path.insert(0, workspace + "/flexible-pipes/scripts")
from delivery import submit
from event_adapter import envelope as event_envelope
execution ∈ object ← importlib.import_module("registered-execution")
base ∈ str ← output + "/tls-service"
Path(base).mkdir(mode=448)
config ∈ dict[str, object] ← json.loads(Path(argv[3]).read_bytes())
config["listen_host"] ← "127.0.0.1"
config["listen_port"] ← 0
config["tls_certificate"] ← base + "/fixture-certificate.pem"
config["tls_private_key"] ← base + "/fixture-private-key.pem"
config["service_ready"] ← base + "/ready.json"
config["service_engine"] ← workspace + "/flexible-pipes/scripts/registered-execution.pi"
config_path ∈ str ← base + "/deployment.json"
Path(config_path).write_text(json.dumps(config, sort_keys=True))
accepted_release ∈ dict[str, object] ← execution.accepted_release(config)
environment ∈ dict[str, str] ← {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "HOME": "/nonexistent"}
with open(base + "/certificate.stderr.bin", "xb") as certificate_log:
    created ∈ object ← subprocess.run(["/usr/bin/openssl", "req", "-new", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "1", "-subj", "/CN=localhost", "-addext", "subjectAltName=IP:127.0.0.1", "-keyout", str(config["tls_private_key"]), "-out", str(config["tls_certificate"])], env=environment, stdout=subprocess.DEVNULL, stderr=certificate_log, timeout=15)
create_code ∈ int ← created.returncode
if create_code != 0:
    raise ValueError("TLS_INTERFACE_UNAVAILABLE")
os.chmod(str(config["tls_private_key"]), 384)
command ∈ list[str] ← list(config["ithon"])
command.extend([workspace + "/flexible-pipes/scripts/registered-service.pi", "qualify", config_path])
with open(base + "/server.stderr.bin", "xb") as server_log:
    server ∈ object ← subprocess.Popen(command, env=environment, stdout=subprocess.DEVNULL, stderr=server_log, start_new_session=True)
    try:
        started ∈ float ← time.monotonic()
        ready ∈ bool ← False
        while not ready:
            ready ← Path(str(config["service_ready"])).exists()
            now ∈ float ← time.monotonic()
            code ∈ object ← server.poll()
            if code != None or now - started > 10.0:
                raise ValueError("TLS_SERVICE_NOT_READY")
            time.sleep(0.02)
        address ∈ dict[str, object] ← json.loads(Path(str(config["service_ready"])).read_bytes())
        url ∈ str ← "https://127.0.0.1:" + str(address["port"]) + "/v1/execute"
        envelope ∈ dict[str, object] ← json.loads(Path(argv[4]).read_bytes())
        request ∈ dict[str, object] ← json.loads(str(envelope["request"]))
        request["request_id"] ← "tls-dispatch"
        envelope["request"] ← json.dumps(request, sort_keys=True)
        context ∈ dict[str, str] ← {"GITHUB_REF": "refs/heads/main", "GITHUB_SHA": str(config["control_commit"]), "GITHUB_RUN_ID": "fixture", "GITHUB_RUN_ATTEMPT": "1", "GITHUB_EVENT_NAME": "workflow_dispatch"}
        mapped ∈ dict[str, object] ← event_envelope({"inputs": {"request": envelope["request"]}}, context, "disposable-non-authorizing-token")
        envelope ← dict(mapped["envelope"])
        first ∈ dict[str, object] ← submit(url, str(config["tls_certificate"]), "workflow_dispatch", envelope, base + "/dispatch", accepted_release)
        if first["status"] != "PASS":
            raise ValueError("TLS_DISPATCH_FAILED: " + str(first.get("first_failure", first.get("blocker"))))
        Path(base + "/dispatch-request.json").write_text(str(envelope["request"]))
        Path(base + "/dispatch-submission.json").write_text(json.dumps({"route": "workflow_dispatch", "envelope": envelope}, sort_keys=True))
        branch_envelope ∈ dict[str, object] ← json.loads(Path(argv[5]).read_bytes())
        context["GITHUB_EVENT_NAME"] ← "workflow_run"
        mapped ← event_envelope({"workflow_run": {"head_branch": "pipeline-requests", "head_repository": {"id": 1405888814}, "head_sha": branch_envelope["request_commit"]}}, context, "disposable-non-authorizing-token")
        branch_envelope ← dict(mapped["envelope"])
        second ∈ dict[str, object] ← submit(url, str(config["tls_certificate"]), "pipeline-requests", branch_envelope, base + "/request-branch", accepted_release)
        if second["status"] != "PASS":
            raise ValueError("TLS_REQUEST_BRANCH_FAILED")
        Path(base + "/request-branch-request.json").write_bytes(base64.b64decode(str(second["request_bytes_base64"]), validate=True))
        Path(base + "/request-branch-submission.json").write_text(json.dumps({"route": "pipeline-requests", "envelope": branch_envelope}, sort_keys=True))
        for route_name in ["dispatch", "request-branch"]:
            captured_environment ∈ dict[str, str] ← dict(environment)
            captured_environment["PYTHONPATH"] ← workspace + "/flexible-pipes/scripts:" + workspace + "/ai-ci/validators"
            gate_command ∈ list[str] ← list(config["ithon"])
            gate_command.extend([workspace + "/ai-ci/tests/registered-delivery/qualify-export.pi", workspace, config_path, base + "/" + route_name + "-request.json", base + "/" + route_name + "/result.json", base + "/" + route_name, base + "/" + route_name + "-submission.json", base + "/" + route_name + "-visible-delivery"])
            captured_gate ∈ object ← subprocess.run(gate_command, env=captured_environment, capture_output=True, timeout=30)
            Path(base + "/" + route_name + "-visible.stdout.bin").write_bytes(captured_gate.stdout)
            Path(base + "/" + route_name + "-visible.stderr.bin").write_bytes(captured_gate.stderr)
            captured_code ∈ int ← captured_gate.returncode
            if captured_code != 0:
                raise ValueError("INDEPENDENT_CAPTURED_DELIVERY_FAILED: " + route_name)
        artifacts ∈ list[dict[str, object]] ← list(first["artifacts"])
        filename ∈ str ← str(artifacts[0]["name"])
        one ∈ bytes ← Path(base + "/dispatch/" + filename).read_bytes()
        two ∈ bytes ← Path(base + "/request-branch/" + filename).read_bytes()
        artifact_digest ∈ str ← hashlib.sha256(one).hexdigest()
        if one != two or artifact_digest != artifacts[0]["sha256"]:
            raise ValueError("TLS_DELIVERY_BYTE_MISMATCH")
        envelope["workflow_ref"] ← "refs/heads/old-workflow"
        rejected ∈ dict[str, object] ← submit(url, str(config["tls_certificate"]), "workflow_dispatch", envelope, base + "/old-workflow", accepted_release)
        if rejected["status"] != "BLOCKED" or rejected["blocker"] != "UNQUALIFIED_WORKFLOW_REF":
            raise ValueError("TLS_OLD_WORKFLOW_ACCEPTED")
        result ∈ dict[str, object] ← {"status": "PASS", "scope": "hosted-candidate-tls-service", "dispatch_run": first["run_id"], "request_branch_run": second["run_id"], "artifact_sha256": hashlib.sha256(one).hexdigest(), "old_workflow": "BLOCKED", "deployment": "inactive"}
        Path(base + "/result.json").write_text(json.dumps(result, sort_keys=True))
    finally:
        try:
            os.killpg(server.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        server.wait()
        Path(str(config["tls_private_key"])).unlink()
print("TLS service and delivery interfaces qualified")
